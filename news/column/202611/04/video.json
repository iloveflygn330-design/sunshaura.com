 "lines": [
  {
   "who": "zundamon",
   "text": "みんな、こんにちは！ずんだもんなのだ！",
   "face": "smile",
   "section": 0,
   "start": 0.6,
   "end": 3.512
  },
  {
   "who": "metan",
   "text": "四国めたんよ。今日もさくっと聞かせてちょうだい。",
   "face": "normal",
   "section": 0,
   "start": 3.762,
   "end": 6.557
  },
  {
   "who": "zundamon",
   "text": "11月4日のVRニュースは3本なのだ。",
   "face": "smile",
   "section": 0,
   "start": 6.807,
   "end": 10.476
  },
  {
   "who": "zundamon",
   "text": "1本目。初音ミクのライブがVRChatで開かれるのだ！",
   "face": "smile",
   "section": 1,
   "start": 11.276,
   "end": 15.831
  },
  {
   "who": "metan",
   "text": "へえ、ミクのライブ？いつやるのよ。",
   "face": "look",
   "section": 1,
   "start": 16.081,
   "end": 18.726
  },
  {
   "who": "zundamon",
   "text": "12月5日、12日、19日の土曜日なのだ。",
   "face": "normal",
   "section": 1,
   "start": 18.976,
   "end": 23.968
  },
  {
   "who": "zundamon",
   "text": "しかも1日3回、朝9時と昼2時と夜10時にやるのだ。",
   "face": "normal",
   "section": 1,
   "start": 24.218,
   "end": 29.306
  },
  {
   "who": "metan",
   "text": "それで、チケットはおいくらなの？",
   "face": "look",
   "section": 1,
   "start": 29.556,
   "end": 31.668
  },
  {
   "who": "zundamon",
   "text": "なんと参加無料なのだ！スマホからも入れるのだ。",
   "face": "smile",
   "section": 1,
   "start": 31.918,
   "end": 35.257
  },
  {
   "who": "metan",
   "text": "無料！？それなら、わたくしも絶対行くわ。",
   "face": "surprise",
   "section": 1,
   "start": 35.507,
   "end": 38.621
  },
  {
   "who": "zundamon",
   "text": "限定アイテムの販売もあるから、お財布は気をつけるのだ。",
   "face": "look",
   "section": 1,
   "start": 38.871,
   "end": 42.957
  },
  {
   "who": "metan",
   "text": "……そこは見なかったことにするわ。",
   "face": "anger",
   "section": 1,
   "start": 43.207,
   "end": 44.839
  },
  {
   "who": "zundamon",
   "text": "2本目。Quest 2とQuest Proの新機能が終わるのだ。",
   "face": "normal",
   "section": 2,
   "start": 45.639,
   "end": 50.46
  },
  {
   "who": "metan",
   "text": "えっ、もう使えなくなっちゃうってこと？",
   "face": "surprise",
   "section": 2,
   "start": 50.71,
   "end": 53.259
  },
  {
   "who": "zundamon",
   "text": "大丈夫なのだ。今あるアプリはそのまま遊べるのだ。",
   "face": "normal",
   "section": 2,
   "start": 53.509,
   "end": 57.232
  },
  {
   "who": "zundamon",
   "text": "最後の大きな更新は、2027年の春までに届くのだ。",
   "face": "normal",
   "section": 2,
   "start": 57.482,
   "end": 62.506
  },
  {
   "who": "zundamon",
   "text": "それ以降の新機能は、Quest 3と3Sからなのだ。",
   "face": "normal",
   "section": 2,
   "start": 62.756,
   "end": 67.257
  },
  {
   "who": "metan",
   "text": "安全のための修正は続くのよね？",
   "face": "normal",
   "section": 2,
   "start": 67.507,
   "end": 69.843
  },
  {
   "who": "zundamon",
   "text": "うん、2027年の終わりまで続くのだ。",
   "face": "smile",
   "section": 2,
   "start": 70.093,
   "end": 73.923
  },
  {
   "who": "metan",
   "text": "買い替えの予定、ちゃんと考えておかないとね。",
   "face": "look",
   "section": 2,
   "start": 74.173,
   "end": 76.989
  },
  {
   "who": "zundamon",
   "text": "3本目。PS VR2が公式ストアから消えたのだ。",
   "face": "surprise",
   "section": 3,
   "start": 77.789,
   "end": 82.365
  },
  {
   "who": "metan",
   "text": "公式ストアって、日本のも？",
   "face": "normal",
   "section": 3,
   "start": 82.615,
   "end": 84.812
  },
  {
   "who": "zundamon",
   "text": "日本とアメリカのストアで、買えなくなっているのだ。",
   "face": "normal",
   "section": 3,
   "start": 85.062,
   "end": 88.571
  },
  {
   "who": "zundamon",
   "text": "アメリカでは、定価より高い転売品が中心らしいのだ。",
   "face": "amazement",
   "section": 3,
   "start": 88.821,
   "end": 92.96
  },
  {
   "who": "metan",
   "text": "高く売られてるなんて、納得いかないわね。",
   "face": "anger",
   "section": 3,
   "start": 93.21,
   "end": 95.919
  },
  {
   "who": "zundamon",
   "text": "ただ、ソニーからの正式な発表はまだないのだ。",
   "face": "normal",
   "section": 3,
   "start": 96.169,
   "end": 99.593
  },
  {
   "who": "metan",
   "text": "続報を待つしかなさそうね。",
   "face": "normal",
   "section": 3,
   "start": 99.843,
   "end": 101.486
  },
  {
   "who": "zundamon",
   "text": "お待ちかね、星座占いなのだ！イタコ、よろしくなのだ。",
   "face": "smile",
   "section": 4,
   "start": 102.286,
   "end": 106.627
  },
  {
   "who": "itako",
   "text": "今日の1位は、かに座。楽しい予定が増えそうですわ。",
   "face": "smile",
   "section": 4,
   "start": 106.877,
   "end": 110.963
  },
  {
   "who": "itako",
   "text": "2位はやぎ座、3位はふたご座です。",
   "face": "normal",
   "section": 4,
   "start": 111.213,
   "end": 114.765
  },
  {
   "who": "zundamon",
   "text": "上位のみんな、いい一日になるのだ！",
   "face": "smile",
   "section": 4,
   "start": 115.015,
   "end": 117.841
  },
  {
   "who": "itako",
   "text": "12位はおとめ座。温かい飲み物でほっとしてくださいね。",
   "face": "normal",
   "section": 4,
   "start": 118.091,
   "end": 122.678
  },
  {
   "who": "zundamon",
   "text": "寒くなってきたし、ずんだシェイク…は冷たいのだ。",
   "face": "amazement",
   "section": 4,
   "start": 122.928,
   "end": 128.208
  },
  {
   "who": "metan",
   "text": "今日はミクのライブが一番の収穫ね。",
   "face": "normal",
   "section": 5,
   "start": 129.008,
   "end": 131.301
  },
  {
   "who": "zundamon",
   "text": "みんな、また明日なのだ！",
   "face": "smile",
   "section": 5,
   "start": 131.551,
   "end": 133.493
  }
 ],
