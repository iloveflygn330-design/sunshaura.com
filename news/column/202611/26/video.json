 "lines": [
  {
   "who": "zundamon",
   "text": "おはようなのだ！今日もVRニュースの時間なのだ。",
   "face": "smile",
   "section": 0,
   "start": 0.6,
   "end": 4.067
  },
  {
   "who": "ankomon",
   "text": "今日はあんこもんが来てやったもん。",
   "face": "point",
   "section": 0,
   "start": 4.317,
   "end": 6.034
  },
  {
   "who": "zundamon",
   "text": "あんこもん、よろしくなのだ。",
   "face": "normal",
   "section": 0,
   "start": 6.284,
   "end": 8.332
  },
  {
   "who": "zundamon",
   "text": "11月26日のニュースは3本なのだ。",
   "face": "normal",
   "section": 0,
   "start": 8.582,
   "end": 12.23
  },
  {
   "who": "zundamon",
   "text": "1本目。VRChatの最新アップデートが来たのだ！",
   "face": "smile",
   "section": 1,
   "start": 13.03,
   "end": 17.051
  },
  {
   "who": "zundamon",
   "text": "バージョンは2026.4.2なのだ。",
   "face": "normal",
   "section": 1,
   "start": 17.301,
   "end": 23.093
  },
  {
   "who": "zundamon",
   "text": "Live Nowのページが、テーマごとの棚に変わったのだ。",
   "face": "normal",
   "section": 1,
   "start": 23.343,
   "end": 26.885
  },
  {
   "who": "ankomon",
   "text": "棚？お店みたいになったってことか？",
   "face": "think",
   "section": 1,
   "start": 27.135,
   "end": 29.897
  },
  {
   "who": "zundamon",
   "text": "そうなのだ。混み具合や言語も見られるのだ。",
   "face": "normal",
   "section": 1,
   "start": 30.147,
   "end": 33.166
  },
  {
   "who": "zundamon",
   "text": "部屋の名前付けも、VRC+なしでできるのだ。",
   "face": "normal",
   "section": 1,
   "start": 33.416,
   "end": 37.224
  },
  {
   "who": "zundamon",
   "text": "ワールドにいいね、よくないねも付けられるのだ。",
   "face": "normal",
   "section": 1,
   "start": 37.474,
   "end": 40.525
  },
  {
   "who": "ankomon",
   "text": "あんこのワールドなら、いいねだらけだもん。",
   "face": "point",
   "section": 1,
   "start": 40.775,
   "end": 43.484
  },
  {
   "who": "zundamon",
   "text": "よくないねは非公開で、おすすめ改善に使うのだ。",
   "face": "normal",
   "section": 1,
   "start": 43.734,
   "end": 47.425
  },
  {
   "who": "zundamon",
   "text": "デスクトップで腕を動かす試験機能もあるのだ。",
   "face": "normal",
   "section": 1,
   "start": 47.675,
   "end": 50.757
  },
  {
   "who": "zundamon",
   "text": "2本目。Vketにサンセイ R&Dが出展するのだ。",
   "face": "normal",
   "section": 2,
   "start": 51.557,
   "end": 56.624
  },
  {
   "who": "zundamon",
   "text": "牙狼の新機種を使ったゲームが遊べるのだ。",
   "face": "normal",
   "section": 2,
   "start": 56.874,
   "end": 59.775
  },
  {
   "who": "ankomon",
   "text": "どんなゲームなんだもん？",
   "face": "think",
   "section": 2,
   "start": 60.025,
   "end": 61.369
  },
  {
   "who": "zundamon",
   "text": "剣を振って、ホラーと戦うのだ！",
   "face": "surprise",
   "section": 2,
   "start": 61.619,
   "end": 64.051
  },
  {
   "who": "zundamon",
   "text": "アンケートに答えると、剣の3Dモデルがもらえるのだ。",
   "face": "normal",
   "section": 2,
   "start": 64.301,
   "end": 68.397
  },
  {
   "who": "ankomon",
   "text": "剣があれば、ずんだもんに勝てるかもしれないもん。",
   "face": "point",
   "section": 2,
   "start": 68.647,
   "end": 71.698
  },
  {
   "who": "zundamon",
   "text": "会期は12月5日から20日、入場無料なのだ。",
   "face": "smile",
   "section": 2,
   "start": 71.948,
   "end": 76.492
  },
  {
   "who": "zundamon",
   "text": "3本目。Live2Dのイベント、alive 2026の続報なのだ。",
   "face": "normal",
   "section": 3,
   "start": 77.292,
   "end": 82.657
  },
  {
   "who": "zundamon",
   "text": "12月11日に、秋葉原で開かれるのだ。",
   "face": "normal",
   "section": 3,
   "start": 82.907,
   "end": 86.438
  },
  {
   "who": "zundamon",
   "text": "講演の第2弾が発表されたのだ。",
   "face": "normal",
   "section": 3,
   "start": 86.688,
   "end": 89.707
  },
  {
   "who": "ankomon",
   "text": "絵を動かす人たちのお祭りってことか？",
   "face": "think",
   "section": 3,
   "start": 89.957,
   "end": 92.229
  },
  {
   "who": "zundamon",
   "text": "そうなのだ。クリエイターマーケットも2年ぶりに復活なのだ。",
   "face": "normal",
   "section": 3,
   "start": 92.479,
   "end": 96.831
  },
  {
   "who": "zundamon",
   "text": "学生は、入場だけなら無料なのだ。",
   "face": "smile",
   "section": 3,
   "start": 97.081,
   "end": 99.939
  },
  {
   "who": "ankomon",
   "text": "作る人たちの話、ちょっと聞いてみたいもん。",
   "face": "normal",
   "section": 3,
   "start": 100.189,
   "end": 103.304
  },
  {
   "who": "zundamon",
   "text": "最後は星座占いなのだ！イタコ、お願いするのだ。",
   "face": "smile",
   "section": 4,
   "start": 104.104,
   "end": 108.115
  },
  {
   "who": "itako",
   "text": "今日の1位は、うお座ですわ。新しい場所で良い出会いが。",
   "face": "smile",
   "section": 4,
   "start": 108.365,
   "end": 112.749
  },
  {
   "who": "itako",
   "text": "2位はおうし座、3位はしし座ですわ。",
   "face": "normal",
   "section": 4,
   "start": 112.999,
   "end": 115.708
  },
  {
   "who": "zundamon",
   "text": "上位のみんな、おめでとうなのだ！",
   "face": "smile",
   "section": 4,
   "start": 115.958,
   "end": 118.358
  },
  {
   "who": "itako",
   "text": "12位はてんびん座。あわてず一歩ずつで大丈夫ですわ。",
   "face": "normal",
   "section": 4,
   "start": 118.608,
   "end": 122.949
  },
  {
   "who": "zundamon",
   "text": "ラッキーアイテムは、あんこのおやつなのだ…。",
   "face": "amazement",
   "section": 4,
   "start": 123.199,
   "end": 127.05
  },
  {
   "who": "ankomon",
   "text": "今日はあんこの勝ちだもん。また来てやるもん。",
   "face": "point",
   "section": 5,
   "start": 127.85,
   "end": 130.783
  },
  {
   "who": "zundamon",
   "text": "占いは勝ち負けじゃないのだ！また明日なのだ！",
   "face": "smile",
   "section": 5,
   "start": 131.033,
   "end": 134.159
  }
 ],
