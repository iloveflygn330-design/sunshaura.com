 "lines": [
  {
   "who": "zundamon",
   "text": "おはようなのだ！今日もVRニュースの時間なのだ。",
   "face": "smile",
   "section": 0,
   "start": 0.6,
   "end": 4.067
  },
  {
   "who": "kiritan",
   "text": "おはようございます。わたしは徹夜明けです。",
   "face": "nihilistic",
   "section": 0,
   "start": 4.317,
   "end": 7.069
  },
  {
   "who": "zundamon",
   "text": "きりたん、ちゃんと寝るのだ…。",
   "face": "amazement",
   "section": 0,
   "start": 7.319,
   "end": 9.345
  },
  {
   "who": "zundamon",
   "text": "11月24日のニュースは4本なのだ。",
   "face": "normal",
   "section": 0,
   "start": 9.595,
   "end": 13.062
  },
  {
   "who": "zundamon",
   "text": "1本目。Bigscreen Beyond 2のセールなのだ。",
   "face": "normal",
   "section": 1,
   "start": 13.862,
   "end": 18.075
  },
  {
   "who": "zundamon",
   "text": "ブラックフライデーで、11月30日までなのだ。",
   "face": "normal",
   "section": 1,
   "start": 18.325,
   "end": 22.229
  },
  {
   "who": "kiritan",
   "text": "どのくらい安くなるんですか？",
   "face": "look",
   "section": 1,
   "start": 22.479,
   "end": 24.165
  },
  {
   "who": "zundamon",
   "text": "コードを使うと、付属品が無料でもらえるのだ。",
   "face": "normal",
   "section": 1,
   "start": 24.415,
   "end": 27.913
  },
  {
   "who": "zundamon",
   "text": "VRChat向けモデルは、さらに50ドル引きなのだ！",
   "face": "surprise",
   "section": 1,
   "start": 28.163,
   "end": 31.961
  },
  {
   "who": "kiritan",
   "text": "合計で最大179ドル。それは大きいですね。",
   "face": "surprise",
   "section": 1,
   "start": 32.211,
   "end": 35.667
  },
  {
   "who": "zundamon",
   "text": "ただ、PCとベースステーションが必要なのだ。",
   "face": "normal",
   "section": 1,
   "start": 35.917,
   "end": 39.255
  },
  {
   "who": "kiritan",
   "text": "本体だけでは遊べない、と。お財布と相談ですね。",
   "face": "nihilistic",
   "section": 1,
   "start": 39.505,
   "end": 43.057
  },
  {
   "who": "zundamon",
   "text": "2本目。VRゲームの賞が12月にあるのだ。",
   "face": "normal",
   "section": 2,
   "start": 43.857,
   "end": 47.9
  },
  {
   "who": "zundamon",
   "text": "名前はVR Forever Awardsなのだ。",
   "face": "normal",
   "section": 2,
   "start": 48.15,
   "end": 52.086
  },
  {
   "who": "zundamon",
   "text": "12月3日から9日まで、Steamでお祭りもあるのだ。",
   "face": "smile",
   "section": 2,
   "start": 52.336,
   "end": 56.453
  },
  {
   "who": "kiritan",
   "text": "お祭りって、何ができるんですか？",
   "face": "look",
   "section": 2,
   "start": 56.703,
   "end": 59.071
  },
  {
   "who": "zundamon",
   "text": "220本以上のゲームが参加するのだ。",
   "face": "normal",
   "section": 2,
   "start": 59.321,
   "end": 62.255
  },
  {
   "who": "zundamon",
   "text": "体験版や値引きもあるのだ。",
   "face": "normal",
   "section": 2,
   "start": 62.505,
   "end": 64.531
  },
  {
   "who": "kiritan",
   "text": "体験版を全部遊ぶには、一週間じゃ足りません。",
   "face": "smile",
   "section": 2,
   "start": 64.781,
   "end": 67.949
  },
  {
   "who": "zundamon",
   "text": "3本目。VRのピンボールが、PS VR2に来るのだ。",
   "face": "normal",
   "section": 3,
   "start": 68.749,
   "end": 74.2
  },
  {
   "who": "zundamon",
   "text": "Pinball FX VRで、発売は11月26日なのだ。",
   "face": "normal",
   "section": 3,
   "start": 74.45,
   "end": 80.871
  },
  {
   "who": "kiritan",
   "text": "値段はどのくらいですか？",
   "face": "normal",
   "section": 3,
   "start": 81.121,
   "end": 82.668
  },
  {
   "who": "zundamon",
   "text": "9.99ドルで、台が3つ入っているのだ。",
   "face": "normal",
   "section": 3,
   "start": 82.918,
   "end": 86.459
  },
  {
   "who": "zundamon",
   "text": "でもQuest版で買った台は、引き継げないのだ。",
   "face": "surprise",
   "section": 3,
   "start": 86.709,
   "end": 89.995
  },
  {
   "who": "kiritan",
   "text": "機種ごとに買い直し。よくある話ですね。",
   "face": "amazement",
   "section": 3,
   "start": 90.245,
   "end": 92.975
  },
  {
   "who": "zundamon",
   "text": "4本目。VRのミニゴルフに新しいコースなのだ。",
   "face": "normal",
   "section": 4,
   "start": 93.775,
   "end": 97.626
  },
  {
   "who": "zundamon",
   "text": "12月3日に、QuestやPS VR2で遊べるのだ。",
   "face": "smile",
   "section": 4,
   "start": 97.876,
   "end": 103.337
  },
  {
   "who": "kiritan",
   "text": "今年はあといくつ出るんですか？",
   "face": "normal",
   "section": 4,
   "start": 103.587,
   "end": 105.358
  },
  {
   "who": "zundamon",
   "text": "今年の追加コースは、これで最後なのだ。",
   "face": "normal",
   "section": 4,
   "start": 105.608,
   "end": 108.584
  },
  {
   "who": "zundamon",
   "text": "それと、Picoへの対応は終わるそうなのだ。",
   "face": "look",
   "section": 4,
   "start": 108.834,
   "end": 111.863
  },
  {
   "who": "kiritan",
   "text": "今までのコースは遊べるなら、ひと安心です。",
   "face": "normal",
   "section": 4,
   "start": 112.113,
   "end": 114.919
  },
  {
   "who": "zundamon",
   "text": "最後は星座占いなのだ！イタコ、お願いするのだ。",
   "face": "smile",
   "section": 5,
   "start": 115.719,
   "end": 119.729
  },
  {
   "who": "itako",
   "text": "今日の1位はしし座。思い切った決断がうまくいきますわ。",
   "face": "smile",
   "section": 5,
   "start": 119.979,
   "end": 124.459
  },
  {
   "who": "itako",
   "text": "2位はうお座、3位はおひつじ座です。",
   "face": "normal",
   "section": 5,
   "start": 124.709,
   "end": 127.344
  },
  {
   "who": "zundamon",
   "text": "うお座は、セール情報に強そうなのだ。",
   "face": "look",
   "section": 5,
   "start": 127.594,
   "end": 130.41
  },
  {
   "who": "itako",
   "text": "12位はてんびん座。ひと休みすれば明日は上向きですわ。",
   "face": "normal",
   "section": 5,
   "start": 130.66,
   "end": 135.759
  },
  {
   "who": "zundamon",
   "text": "てんびん座のみんな、無理せずいくのだ。",
   "face": "normal",
   "section": 5,
   "start": 136.009,
   "end": 139.059
  },
  {
   "who": "kiritan",
   "text": "以上です。わたしはこれから寝ます。",
   "face": "nihilistic",
   "section": 6,
   "start": 139.859,
   "end": 142.217
  },
  {
   "who": "zundamon",
   "text": "おやすみなのだ…じゃなくて、また明日なのだ！",
   "face": "smile",
   "section": 6,
   "start": 142.467,
   "end": 145.656
  }
 ],
