 "lines": [
  {
   "who": "zundamon",
   "text": "みんな、おはようなのだ！ずんだもんなのだ。",
   "face": "smile",
   "section": 0,
   "start": 0.6,
   "end": 3.768
  },
  {
   "who": "kiritan",
   "text": "おはようございます。わたしは夜更かし明けです。",
   "face": "nihilistic",
   "section": 0,
   "start": 4.018,
   "end": 6.866
  },
  {
   "who": "zundamon",
   "text": "11月17日のVRニュースは3本なのだ。",
   "face": "normal",
   "section": 0,
   "start": 7.116,
   "end": 11.159
  },
  {
   "who": "zundamon",
   "text": "1本目。VRChatの公式ショップに新アイテムなのだ。",
   "face": "normal",
   "section": 1,
   "start": 11.959,
   "end": 16.609
  },
  {
   "who": "zundamon",
   "text": "ラブライブ！サンシャイン!!のGuilty Kissとのコラボなのだ。",
   "face": "smile",
   "section": 1,
   "start": 16.859,
   "end": 20.347
  },
  {
   "who": "kiritan",
   "text": "どんなアイテムが買えるんですか？",
   "face": "look",
   "section": 1,
   "start": 20.597,
   "end": 22.325
  },
  {
   "who": "zundamon",
   "text": "メンバーとお揃いのアクセサリーや、ポータルがあるのだ。",
   "face": "normal",
   "section": 1,
   "start": 22.575,
   "end": 26.266
  },
  {
   "who": "zundamon",
   "text": "販売は12月16日の朝9時までの限定なのだ。",
   "face": "normal",
   "section": 1,
   "start": 26.516,
   "end": 31.145
  },
  {
   "who": "kiritan",
   "text": "期間限定と言われると、つい気になりますね。",
   "face": "normal",
   "section": 1,
   "start": 31.395,
   "end": 34.158
  },
  {
   "who": "zundamon",
   "text": "22日と23日には、ミュージカルのVRChat配信もあるのだ。",
   "face": "normal",
   "section": 1,
   "start": 34.408,
   "end": 39.923
  },
  {
   "who": "kiritan",
   "text": "会場を再現した練習用ワールドもあるそうです。",
   "face": "smile",
   "section": 1,
   "start": 40.173,
   "end": 43.021
  },
  {
   "who": "zundamon",
   "text": "2本目。Shiftallのオフ会タグなのだ。",
   "face": "normal",
   "section": 2,
   "start": 43.821,
   "end": 47.138
  },
  {
   "who": "zundamon",
   "text": "VRの頭の上の名前を、現実で首から下げられるのだ。",
   "face": "normal",
   "section": 2,
   "start": 47.388,
   "end": 51.815
  },
  {
   "who": "kiritan",
   "text": "オフ会で、誰が誰だか分からない問題の対策ですね。",
   "face": "look",
   "section": 2,
   "start": 52.065,
   "end": 55.553
  },
  {
   "who": "zundamon",
   "text": "丸い画面に、アバターの顔やアイコンを映せるのだ。",
   "face": "normal",
   "section": 2,
   "start": 55.803,
   "end": 59.493
  },
  {
   "who": "zundamon",
   "text": "セットで9999円、届くのは来年1月の予定なのだ。",
   "face": "normal",
   "section": 2,
   "start": 59.743,
   "end": 65.877
  },
  {
   "who": "kiritan",
   "text": "名前のプレートは、付け替えもできるんですよね。",
   "face": "normal",
   "section": 2,
   "start": 66.127,
   "end": 68.836
  },
  {
   "who": "zundamon",
   "text": "マグネットで、すぐ交換できるのだ！",
   "face": "smile",
   "section": 2,
   "start": 69.086,
   "end": 71.721
  },
  {
   "who": "kiritan",
   "text": "人見知りでも、話しかけるきっかけになりそうです。",
   "face": "normal",
   "section": 2,
   "start": 71.971,
   "end": 74.968
  },
  {
   "who": "zundamon",
   "text": "3本目。MeganeX 8K Mark IIに透明なモデルなのだ。",
   "face": "normal",
   "section": 3,
   "start": 75.768,
   "end": 81.549
  },
  {
   "who": "zundamon",
   "text": "クリアとクリアブラックの2色で、中の基板が見えるのだ。",
   "face": "normal",
   "section": 3,
   "start": 81.799,
   "end": 86.13
  },
  {
   "who": "kiritan",
   "text": "スケルトンは、ゲーム機でも人気のデザインですね。",
   "face": "smile",
   "section": 3,
   "start": 86.38,
   "end": 89.367
  },
  {
   "who": "zundamon",
   "text": "本体は179gで、とっても軽いのだ。",
   "face": "normal",
   "section": 3,
   "start": 89.617,
   "end": 93.67
  },
  {
   "who": "kiritan",
   "text": "それで、お値段はいくらなんですか？",
   "face": "normal",
   "section": 3,
   "start": 93.92,
   "end": 96.277
  },
  {
   "who": "zundamon",
   "text": "27万9900円なのだ……。",
   "face": "surprise",
   "section": 3,
   "start": 96.527,
   "end": 100.293
  },
  {
   "who": "kiritan",
   "text": "見た目にこだわりたい人には、うれしい選択肢ですね。",
   "face": "nihilistic",
   "section": 3,
   "start": 100.543,
   "end": 103.807
  },
  {
   "who": "zundamon",
   "text": "最後は星座占いなのだ！イタコ、よろしくなのだ。",
   "face": "smile",
   "section": 4,
   "start": 104.607,
   "end": 108.479
  },
  {
   "who": "itako",
   "text": "1位はかに座。仲間との時間が力になりますわ。",
   "face": "smile",
   "section": 4,
   "start": 108.729,
   "end": 112.899
  },
  {
   "who": "itako",
   "text": "2位はてんびん座、3位はおひつじ座です。",
   "face": "normal",
   "section": 4,
   "start": 113.149,
   "end": 117.032
  },
  {
   "who": "zundamon",
   "text": "かに座の人は、名札を付けて出かけるといいのだ！",
   "face": "normal",
   "section": 4,
   "start": 117.282,
   "end": 120.567
  },
  {
   "who": "itako",
   "text": "12位はおとめ座。早めに休めば明日は好調ですわ。",
   "face": "normal",
   "section": 4,
   "start": 120.817,
   "end": 125.831
  },
  {
   "who": "zundamon",
   "text": "アイマスクして、ぐっすり寝るのだ〜。",
   "face": "normal",
   "section": 4,
   "start": 126.081,
   "end": 129.259
  },
  {
   "who": "kiritan",
   "text": "今日もお付き合い、ありがとうございました。",
   "face": "normal",
   "section": 5,
   "start": 130.059,
   "end": 132.502
  },
  {
   "who": "zundamon",
   "text": "また明日も見に来てほしいのだ！ばいばいなのだ！",
   "face": "smile",
   "section": 5,
   "start": 132.752,
   "end": 135.952
  }
 ],
