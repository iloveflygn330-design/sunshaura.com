 "lines": [
  {
   "who": "zundamon",
   "text": "おはようなのだ！ずんだもんのVRニュースなのだ。",
   "face": "smile",
   "section": 0,
   "start": 0.6,
   "end": 4.013
  },
  {
   "who": "metan",
   "text": "おはよう。日曜なのに早起きね。",
   "face": "smile",
   "section": 0,
   "start": 4.263,
   "end": 6.514
  },
  {
   "who": "zundamon",
   "text": "11月22日のニュースは4本なのだ。",
   "face": "normal",
   "section": 0,
   "start": 6.764,
   "end": 10.273
  },
  {
   "who": "zundamon",
   "text": "1本目。VRChatのライブの後夜祭の話なのだ。",
   "face": "normal",
   "section": 1,
   "start": 11.073,
   "end": 15.073
  },
  {
   "who": "zundamon",
   "text": "グゲンカが、後夜祭の技術を手伝うのだ。",
   "face": "normal",
   "section": 1,
   "start": 15.323,
   "end": 18.278
  },
  {
   "who": "metan",
   "text": "後夜祭って、いつやるの？",
   "face": "look",
   "section": 1,
   "start": 18.528,
   "end": 20.32
  },
  {
   "who": "zundamon",
   "text": "今夜22時から、ワールド「CLUB深海」なのだ。",
   "face": "smile",
   "section": 1,
   "start": 20.57,
   "end": 24.879
  },
  {
   "who": "zundamon",
   "text": "演者の映像と声を、別の部屋にも同時に届けるのだ。",
   "face": "normal",
   "section": 1,
   "start": 25.129,
   "end": 29.183
  },
  {
   "who": "metan",
   "text": "満員でも入れないってことが減るのね。",
   "face": "normal",
   "section": 1,
   "start": 29.433,
   "end": 31.417
  },
  {
   "who": "zundamon",
   "text": "参加は無料。ただしPC版だけなのだ。",
   "face": "normal",
   "section": 1,
   "start": 31.667,
   "end": 34.781
  },
  {
   "who": "metan",
   "text": "無料なのは、わたくし的にとても大事よ。",
   "face": "smile",
   "section": 1,
   "start": 35.031,
   "end": 37.602
  },
  {
   "who": "zundamon",
   "text": "2本目。SteamVRのベータ版の更新なのだ。",
   "face": "normal",
   "section": 2,
   "start": 38.402,
   "end": 42.125
  },
  {
   "who": "zundamon",
   "text": "PCからの配信が、前より安定するのだ。",
   "face": "normal",
   "section": 2,
   "start": 42.375,
   "end": 45.809
  },
  {
   "who": "metan",
   "text": "ワイヤレスでVRをするときの話ね。",
   "face": "normal",
   "section": 2,
   "start": 46.059,
   "end": 48.31
  },
  {
   "who": "zundamon",
   "text": "ノートPCでは、強いGPUを自動で選ぶのだ。",
   "face": "normal",
   "section": 2,
   "start": 48.56,
   "end": 52.411
  },
  {
   "who": "zundamon",
   "text": "VRChatの背景の表示の不具合も直ったのだ。",
   "face": "smile",
   "section": 2,
   "start": 52.661,
   "end": 56.234
  },
  {
   "who": "metan",
   "text": "地味だけど、うれしい直し方じゃない。",
   "face": "normal",
   "section": 2,
   "start": 56.484,
   "end": 58.82
  },
  {
   "who": "zundamon",
   "text": "3本目。Steam Frameのベータ更新なのだ。",
   "face": "normal",
   "section": 3,
   "start": 59.62,
   "end": 63.097
  },
  {
   "who": "zundamon",
   "text": "コントローラーの振動を、ゲームごとに変えられるのだ。",
   "face": "normal",
   "section": 3,
   "start": 63.347,
   "end": 66.985
  },
  {
   "who": "metan",
   "text": "ゲームによって、強すぎたりするものね。",
   "face": "look",
   "section": 3,
   "start": 67.235,
   "end": 69.752
  },
  {
   "who": "zundamon",
   "text": "画面をくっきりさせる設定も増えたのだ。",
   "face": "normal",
   "section": 3,
   "start": 70.002,
   "end": 72.711
  },
  {
   "who": "zundamon",
   "text": "PCからの配信の解像度も上がったのだ。",
   "face": "smile",
   "section": 3,
   "start": 72.961,
   "end": 75.991
  },
  {
   "who": "metan",
   "text": "ベータだから、試すなら自己責任ね。",
   "face": "normal",
   "section": 3,
   "start": 76.241,
   "end": 78.619
  },
  {
   "who": "zundamon",
   "text": "4本目。Quest 3Sのセット販売なのだ。",
   "face": "normal",
   "section": 4,
   "start": 79.419,
   "end": 82.897
  },
  {
   "who": "zundamon",
   "text": "Xboxの小さいコントローラーが付いてくるのだ。",
   "face": "normal",
   "section": 4,
   "start": 83.147,
   "end": 86.645
  },
  {
   "who": "metan",
   "text": "それで、お値段はいくらなの？",
   "face": "look",
   "section": 4,
   "start": 86.895,
   "end": 88.879
  },
  {
   "who": "zundamon",
   "text": "399.98ドル。アメリカとカナダで売るのだ。",
   "face": "normal",
   "section": 4,
   "start": 89.129,
   "end": 93.417
  },
  {
   "who": "zundamon",
   "text": "ゲームパスの2か月分も付いているのだ。",
   "face": "normal",
   "section": 4,
   "start": 93.667,
   "end": 96.643
  },
  {
   "who": "zundamon",
   "text": "でも無料期間は、初めての人だけなのだ。",
   "face": "normal",
   "section": 4,
   "start": 96.893,
   "end": 100.04
  },
  {
   "who": "metan",
   "text": "前に使った人は対象外なの？ケチね。",
   "face": "anger",
   "section": 4,
   "start": 100.29,
   "end": 103.202
  },
  {
   "who": "zundamon",
   "text": "条件は、よく確かめてから買うのだ。",
   "face": "normal",
   "section": 4,
   "start": 103.452,
   "end": 106.215
  },
  {
   "who": "zundamon",
   "text": "最後は星座占いなのだ！イタコ、お願いするのだ。",
   "face": "smile",
   "section": 5,
   "start": 107.015,
   "end": 111.025
  },
  {
   "who": "itako",
   "text": "今日の1位は、ふたご座ですわ。仲間との時間が輝きます。",
   "face": "smile",
   "section": 5,
   "start": 111.275,
   "end": 115.969
  },
  {
   "who": "itako",
   "text": "2位はやぎ座、3位はうお座です。",
   "face": "normal",
   "section": 5,
   "start": 116.219,
   "end": 118.672
  },
  {
   "who": "zundamon",
   "text": "ふたご座の人は、今夜の後夜祭にぴったりなのだ。",
   "face": "normal",
   "section": 5,
   "start": 118.922,
   "end": 122.357
  },
  {
   "who": "itako",
   "text": "12位はおひつじ座。ひと休みすれば運が上向きますわ。",
   "face": "normal",
   "section": 5,
   "start": 122.607,
   "end": 126.575
  },
  {
   "who": "zundamon",
   "text": "ラッキーアイテムはずんだ餅！最高なのだ！",
   "face": "smile",
   "section": 5,
   "start": 126.825,
   "end": 130.334
  },
  {
   "who": "metan",
   "text": "今日はここまで。ゆっくり休みなさいよね。",
   "face": "smile",
   "section": 6,
   "start": 131.134,
   "end": 133.854
  },
  {
   "who": "zundamon",
   "text": "みんな、また明日なのだ！",
   "face": "smile",
   "section": 6,
   "start": 134.104,
   "end": 136.045
  }
 ],
