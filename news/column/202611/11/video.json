 "lines": [
  {
   "who": "zundamon",
   "text": "みんな、おはようなのだ！ずんだもんなのだ！",
   "face": "smile",
   "section": 0,
   "start": 0.6,
   "end": 3.768
  },
  {
   "who": "metan",
   "text": "四国めたんよ。今日も手短にお願いね。",
   "face": "normal",
   "section": 0,
   "start": 4.018,
   "end": 6.685
  },
  {
   "who": "zundamon",
   "text": "11月11日のVRニュースは3本なのだ。",
   "face": "smile",
   "section": 0,
   "start": 6.935,
   "end": 11.02
  },
  {
   "who": "zundamon",
   "text": "1本目。VRChatのオープンベータが公開されたのだ。",
   "face": "normal",
   "section": 1,
   "start": 11.82,
   "end": 16.076
  },
  {
   "who": "zundamon",
   "text": "ワールドにLikeとDislikeのボタンが付いたのだ！",
   "face": "smile",
   "section": 1,
   "start": 16.326,
   "end": 19.814
  },
  {
   "who": "metan",
   "text": "Dislikeって、作った人がへこまないかしら。",
   "face": "look",
   "section": 1,
   "start": 20.064,
   "end": 22.763
  },
  {
   "who": "zundamon",
   "text": "Dislikeはほかの人には見えない仕組みなのだ。",
   "face": "normal",
   "section": 1,
   "start": 23.013,
   "end": 26.309
  },
  {
   "who": "zundamon",
   "text": "Likeは、おすすめを良くするのに使われるのだ。",
   "face": "normal",
   "section": 1,
   "start": 26.559,
   "end": 29.855
  },
  {
   "who": "metan",
   "text": "ふーん、それなら安心ね。",
   "face": "normal",
   "section": 1,
   "start": 30.105,
   "end": 32.014
  },
  {
   "who": "zundamon",
   "text": "Live Nowも、テーマ別に混み具合が分かるのだ。",
   "face": "normal",
   "section": 1,
   "start": 32.264,
   "end": 35.624
  },
  {
   "who": "metan",
   "text": "入る前に雰囲気が分かるのは、地味にうれしいわ。",
   "face": "smile",
   "section": 1,
   "start": 35.874,
   "end": 38.903
  },
  {
   "who": "zundamon",
   "text": "2本目。Blenderのアドオン、FaceKeys 2.1なのだ。",
   "face": "normal",
   "section": 2,
   "start": 39.703,
   "end": 44.525
  },
  {
   "who": "zundamon",
   "text": "フェイストラッキング用の表情を自動で作るのだ。",
   "face": "normal",
   "section": 2,
   "start": 44.775,
   "end": 47.996
  },
  {
   "who": "metan",
   "text": "自動で？どのくらい作れるのよ。",
   "face": "surprise",
   "section": 2,
   "start": 48.246,
   "end": 50.379
  },
  {
   "who": "zundamon",
   "text": "102種類のうち75種類を、ワンクリックなのだ！",
   "face": "smile",
   "section": 2,
   "start": 50.629,
   "end": 55.003
  },
  {
   "who": "zundamon",
   "text": "失敗しても、Undo1回で元に戻せるのだ。",
   "face": "normal",
   "section": 2,
   "start": 55.253,
   "end": 58.602
  },
  {
   "who": "metan",
   "text": "それで、お値段はおいくら？",
   "face": "look",
   "section": 2,
   "start": 58.852,
   "end": 60.751
  },
  {
   "who": "zundamon",
   "text": "ライト版が1500円、フル版が3000円なのだ。",
   "face": "normal",
   "section": 2,
   "start": 61.001,
   "end": 65.705
  },
  {
   "who": "metan",
   "text": "手作業の時間を考えたら、悪くないわね。",
   "face": "anger",
   "section": 2,
   "start": 65.955,
   "end": 68.739
  },
  {
   "who": "zundamon",
   "text": "3本目。QuestAssist 2.0が公開されたのだ。",
   "face": "normal",
   "section": 3,
   "start": 69.539,
   "end": 73.997
  },
  {
   "who": "zundamon",
   "text": "PCのアバターを、Quest向けに変換するツールなのだ。",
   "face": "normal",
   "section": 3,
   "start": 74.247,
   "end": 78.173
  },
  {
   "who": "metan",
   "text": "軽くすると、見た目が崩れたりしないの？",
   "face": "look",
   "section": 3,
   "start": 78.423,
   "end": 81.1
  },
  {
   "who": "zundamon",
   "text": "顔や手など、よく見られる所を残すようにしたのだ。",
   "face": "normal",
   "section": 3,
   "start": 81.35,
   "end": 84.934
  },
  {
   "who": "zundamon",
   "text": "元の形とのずれが、前の約半分になったそうなのだ。",
   "face": "smile",
   "section": 3,
   "start": 85.184,
   "end": 89.163
  },
  {
   "who": "metan",
   "text": "しかも無料版もあるのね。助かるわ。",
   "face": "smile",
   "section": 3,
   "start": 89.413,
   "end": 91.759
  },
  {
   "who": "zundamon",
   "text": "揺れものも、PC版と同じ動きになるのだ。",
   "face": "normal",
   "section": 3,
   "start": 92.009,
   "end": 95.348
  },
  {
   "who": "zundamon",
   "text": "最後は星座占いなのだ！イタコ、よろしくなのだ。",
   "face": "smile",
   "section": 4,
   "start": 96.148,
   "end": 100.02
  },
  {
   "who": "itako",
   "text": "今日の1位は、おうし座。新しい道具が手になじむ日ですわ。",
   "face": "smile",
   "section": 4,
   "start": 100.27,
   "end": 104.75
  },
  {
   "who": "itako",
   "text": "2位はしし座、3位はうお座ですわ。",
   "face": "normal",
   "section": 4,
   "start": 105,
   "end": 107.592
  },
  {
   "who": "zundamon",
   "text": "1位のおうし座は、アバター作りがはかどりそうなのだ。",
   "face": "normal",
   "section": 4,
   "start": 107.842,
   "end": 111.49
  },
  {
   "who": "itako",
   "text": "12位はいて座。のんびり進めば大丈夫ですよ。",
   "face": "normal",
   "section": 4,
   "start": 111.74,
   "end": 115.772
  },
  {
   "who": "zundamon",
   "text": "ラッキーアイテムはずんだ餅！最高なのだ！",
   "face": "smile",
   "section": 4,
   "start": 116.022,
   "end": 119.531
  },
  {
   "who": "metan",
   "text": "今日も聞いてくれてありがとう。またね。",
   "face": "smile",
   "section": 5,
   "start": 120.331,
   "end": 122.582
  },
  {
   "who": "zundamon",
   "text": "また明日も見てほしいのだ！",
   "face": "smile",
   "section": 5,
   "start": 122.832,
   "end": 124.645
  }
 ],
