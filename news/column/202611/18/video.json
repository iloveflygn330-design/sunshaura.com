 "lines": [
  {
   "who": "zundamon",
   "text": "おはようなのだ！ずんだもんなのだ！",
   "face": "smile",
   "section": 0,
   "start": 0.6,
   "end": 2.968
  },
  {
   "who": "metan",
   "text": "四国めたんよ。今日もさくっといきましょ。",
   "face": "normal",
   "section": 0,
   "start": 3.218,
   "end": 5.714
  },
  {
   "who": "zundamon",
   "text": "11月18日のVRニュースは3本なのだ。",
   "face": "normal",
   "section": 0,
   "start": 5.964,
   "end": 10.06
  },
  {
   "who": "zundamon",
   "text": "1本目。アイマリンプロジェクトのVR LIVE第2弾なのだ。",
   "face": "smile",
   "section": 1,
   "start": 10.86,
   "end": 16.033
  },
  {
   "who": "zundamon",
   "text": "会場はVRChatのライブ特設ワールドなのだ。",
   "face": "normal",
   "section": 1,
   "start": 16.283,
   "end": 20.113
  },
  {
   "who": "metan",
   "text": "いつやるの？週末なら行けるかも。",
   "face": "look",
   "section": 1,
   "start": 20.363,
   "end": 22.731
  },
  {
   "who": "zundamon",
   "text": "11月21日と22日に、それぞれ3回公演なのだ。",
   "face": "normal",
   "section": 1,
   "start": 22.981,
   "end": 28.303
  },
  {
   "who": "zundamon",
   "text": "22日の夜には、ゲストが出る後夜祭もあるのだ。",
   "face": "normal",
   "section": 1,
   "start": 28.553,
   "end": 32.297
  },
  {
   "who": "metan",
   "text": "回数が多いと、時間を選べて助かるわね。",
   "face": "smile",
   "section": 1,
   "start": 32.547,
   "end": 35.481
  },
  {
   "who": "zundamon",
   "text": "ただしPCVRのみで、Quest単体は入れないのだ。",
   "face": "surprise",
   "section": 1,
   "start": 35.731,
   "end": 40.275
  },
  {
   "who": "metan",
   "text": "ダウンロードも大きいみたいだし、早めに準備ね。",
   "face": "normal",
   "section": 1,
   "start": 40.525,
   "end": 43.511
  },
  {
   "who": "zundamon",
   "text": "2本目。音楽フェスESPERAのアイテムが出たのだ。",
   "face": "normal",
   "section": 2,
   "start": 44.311,
   "end": 48.151
  },
  {
   "who": "zundamon",
   "text": "ペンライトやTシャツなど、全部で4種類なのだ。",
   "face": "normal",
   "section": 2,
   "start": 48.401,
   "end": 51.943
  },
  {
   "who": "metan",
   "text": "で、お値段は？そこが一番大事よ。",
   "face": "anger",
   "section": 2,
   "start": 52.193,
   "end": 55.211
  },
  {
   "who": "zundamon",
   "text": "ペンライトは550円、Tシャツは1650円なのだ。",
   "face": "normal",
   "section": 2,
   "start": 55.461,
   "end": 60.933
  },
  {
   "who": "metan",
   "text": "ペンライトなら、わたくしでも手が届くわ。",
   "face": "smile",
   "section": 2,
   "start": 61.183,
   "end": 63.573
  },
  {
   "who": "zundamon",
   "text": "フェスは11月20日から22日の3日間なのだ。",
   "face": "normal",
   "section": 2,
   "start": 63.823,
   "end": 68.655
  },
  {
   "who": "zundamon",
   "text": "20日と21日は無料で見られるのだ！",
   "face": "smile",
   "section": 2,
   "start": 68.905,
   "end": 72.499
  },
  {
   "who": "metan",
   "text": "無料の日があるなら、まずはそこからね。",
   "face": "look",
   "section": 2,
   "start": 72.749,
   "end": 75.075
  },
  {
   "who": "zundamon",
   "text": "3本目。バーチャル店員のxR Castなのだ。",
   "face": "normal",
   "section": 3,
   "start": 75.875,
   "end": 80.227
  },
  {
   "who": "zundamon",
   "text": "HEP FIVEなどの商業施設で、本格採用されたのだ。",
   "face": "normal",
   "section": 3,
   "start": 80.477,
   "end": 84.615
  },
  {
   "who": "metan",
   "text": "アバターが接客するの？ちょっと気になるわ。",
   "face": "surprise",
   "section": 3,
   "start": 84.865,
   "end": 87.585
  },
  {
   "who": "zundamon",
   "text": "簡単な質問には、アバターが自動で答えるのだ。",
   "face": "normal",
   "section": 3,
   "start": 87.835,
   "end": 91.483
  },
  {
   "who": "zundamon",
   "text": "難しい相談は、遠くのスタッフが代わるのだ。",
   "face": "normal",
   "section": 3,
   "start": 91.733,
   "end": 95.147
  },
  {
   "who": "metan",
   "text": "人と自動の使い分けね。よくできてるじゃない。",
   "face": "normal",
   "section": 3,
   "start": 95.397,
   "end": 98.17
  },
  {
   "who": "zundamon",
   "text": "いつか僕も、ずんだ餅屋さんの店員をやりたいのだ。",
   "face": "smile",
   "section": 3,
   "start": 98.42,
   "end": 102.111
  },
  {
   "who": "zundamon",
   "text": "最後は星座占いなのだ！イタコ、お願いするのだ。",
   "face": "smile",
   "section": 4,
   "start": 102.911,
   "end": 106.921
  },
  {
   "who": "itako",
   "text": "今日の1位は、みずがめ座。ひらめきが形になる日ですわ。",
   "face": "smile",
   "section": 4,
   "start": 107.171,
   "end": 111.47
  },
  {
   "who": "itako",
   "text": "2位はやぎ座、3位はふたご座です。",
   "face": "normal",
   "section": 4,
   "start": 111.72,
   "end": 114.301
  },
  {
   "who": "zundamon",
   "text": "ふたご座のラッキーアイテムはペンライトなのだ！",
   "face": "surprise",
   "section": 4,
   "start": 114.551,
   "end": 117.709
  },
  {
   "who": "itako",
   "text": "12位はいて座。一歩ずつで大丈夫ですわ。",
   "face": "normal",
   "section": 4,
   "start": 117.959,
   "end": 121.777
  },
  {
   "who": "zundamon",
   "text": "ラッキーアイテムがずんだ餅なら、むしろ当たりなのだ。",
   "face": "smile",
   "section": 4,
   "start": 122.027,
   "end": 125.889
  },
  {
   "who": "metan",
   "text": "週末のライブ、行けたら行ってみるわ。またね。",
   "face": "smile",
   "section": 5,
   "start": 126.689,
   "end": 129.601
  },
  {
   "who": "zundamon",
   "text": "また明日も見てほしいのだ！",
   "face": "smile",
   "section": 5,
   "start": 129.851,
   "end": 131.664
  }
 ],
