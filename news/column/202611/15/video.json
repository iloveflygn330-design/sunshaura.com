 "lines": [
  {
   "who": "zundamon",
   "text": "おはようなのだ！日曜日のVRニュースなのだ。",
   "face": "smile",
   "section": 0,
   "start": 0.6,
   "end": 3.971
  },
  {
   "who": "metan",
   "text": "おはよう。日曜の朝から元気ね、ずんだもん。",
   "face": "smile",
   "section": 0,
   "start": 4.221,
   "end": 7.517
  },
  {
   "who": "zundamon",
   "text": "めたん、今日もよろしくなのだ。",
   "face": "normal",
   "section": 0,
   "start": 7.767,
   "end": 9.889
  },
  {
   "who": "zundamon",
   "text": "11月15日のニュースは4本なのだ。",
   "face": "normal",
   "section": 0,
   "start": 10.139,
   "end": 13.531
  },
  {
   "who": "zundamon",
   "text": "1本目。雪の街のVRChatワールドの紹介なのだ。",
   "face": "normal",
   "section": 1,
   "start": 14.331,
   "end": 18.598
  },
  {
   "who": "zundamon",
   "text": "名前は「さよならの、その先で。」なのだ。",
   "face": "normal",
   "section": 1,
   "start": 18.848,
   "end": 22.261
  },
  {
   "who": "metan",
   "text": "なんだか切ない名前ね。どんな場所なの？",
   "face": "look",
   "section": 1,
   "start": 22.511,
   "end": 25.157
  },
  {
   "who": "zundamon",
   "text": "崩れた大きな街が、雪に埋もれているのだ。",
   "face": "normal",
   "section": 1,
   "start": 25.407,
   "end": 28.671
  },
  {
   "who": "zundamon",
   "text": "建物の中には、ソファや暖炉のお部屋があるのだ。",
   "face": "normal",
   "section": 1,
   "start": 28.921,
   "end": 32.462
  },
  {
   "who": "metan",
   "text": "廃墟なのに、ちょっと暖かそうじゃない。",
   "face": "normal",
   "section": 1,
   "start": 32.712,
   "end": 35.027
  },
  {
   "who": "zundamon",
   "text": "オレンジの街灯が、雪景色を照らしているのだ。",
   "face": "smile",
   "section": 1,
   "start": 35.277,
   "end": 38.626
  },
  {
   "who": "zundamon",
   "text": "遊ぶには、PCが必要と書かれているのだ。",
   "face": "normal",
   "section": 1,
   "start": 38.876,
   "end": 42.172
  },
  {
   "who": "metan",
   "text": "暖房代がかからない冬の家、いいわね。",
   "face": "eat",
   "section": 1,
   "start": 42.422,
   "end": 45.185
  },
  {
   "who": "zundamon",
   "text": "2本目。AppleがvisionOSに力を入れると話したのだ。",
   "face": "normal",
   "section": 2,
   "start": 45.985,
   "end": 50.529
  },
  {
   "who": "metan",
   "text": "Vision Proのこと？最近静かだったわよね。",
   "face": "look",
   "section": 2,
   "start": 50.779,
   "end": 53.627
  },
  {
   "who": "zundamon",
   "text": "医療や教育で、使う場面が増えているそうなのだ。",
   "face": "normal",
   "section": 2,
   "start": 53.877,
   "end": 57.471
  },
  {
   "who": "zundamon",
   "text": "立体映像の生中継も、他の会社の道具で作れるようになるのだ。",
   "face": "normal",
   "section": 2,
   "start": 57.721,
   "end": 62.596
  },
  {
   "who": "zundamon",
   "text": "2027年の前半を目標にしているのだ。",
   "face": "normal",
   "section": 2,
   "start": 62.846,
   "end": 66.206
  },
  {
   "who": "metan",
   "text": "で、新しいヘッドセットはどうなの？",
   "face": "surprise",
   "section": 2,
   "start": 66.456,
   "end": 68.963
  },
  {
   "who": "zundamon",
   "text": "それについては、何も話さなかったのだ。",
   "face": "amazement",
   "section": 2,
   "start": 69.213,
   "end": 72.071
  },
  {
   "who": "metan",
   "text": "そこが一番知りたいのに、もったいぶるわね。",
   "face": "anger",
   "section": 2,
   "start": 72.321,
   "end": 74.956
  },
  {
   "who": "zundamon",
   "text": "3本目。Mothergunship: ForgeがPS VR2で出たのだ。",
   "face": "normal",
   "section": 3,
   "start": 75.756,
   "end": 80.545
  },
  {
   "who": "zundamon",
   "text": "発表したその日に、いきなり発売されたのだ！",
   "face": "surprise",
   "section": 3,
   "start": 80.795,
   "end": 84.081
  },
  {
   "who": "metan",
   "text": "サプライズ発売ってやつね。どんなゲーム？",
   "face": "normal",
   "section": 3,
   "start": 84.331,
   "end": 86.997
  },
  {
   "who": "zundamon",
   "text": "自分で銃を組み立てて戦う、ローグライトなのだ。",
   "face": "normal",
   "section": 3,
   "start": 87.247,
   "end": 90.671
  },
  {
   "who": "zundamon",
   "text": "毎日挑戦できるデイリーランも入っているのだ。",
   "face": "normal",
   "section": 3,
   "start": 90.921,
   "end": 94.089
  },
  {
   "who": "zundamon",
   "text": "PS VR2の振動やトリガーの機能にも対応なのだ。",
   "face": "normal",
   "section": 3,
   "start": 94.339,
   "end": 98.499
  },
  {
   "who": "metan",
   "text": "銃を組み立てる…わたくしの中二心がうずくわ。",
   "face": "smile",
   "section": 3,
   "start": 98.749,
   "end": 101.875
  },
  {
   "who": "zundamon",
   "text": "4本目。ロボット対戦のIron RebellionがPS VR2に来るのだ。",
   "face": "normal",
   "section": 4,
   "start": 102.675,
   "end": 108.147
  },
  {
   "who": "zundamon",
   "text": "年内の発売を予定しているのだ。",
   "face": "normal",
   "section": 4,
   "start": 108.397,
   "end": 110.829
  },
  {
   "who": "metan",
   "text": "ロボットに乗って戦うの？かっこいいじゃない。",
   "face": "smile",
   "section": 4,
   "start": 111.079,
   "end": 113.831
  },
  {
   "who": "zundamon",
   "text": "最大8対8で戦える、対戦ゲームなのだ。",
   "face": "normal",
   "section": 4,
   "start": 114.081,
   "end": 118.262
  },
  {
   "who": "zundamon",
   "text": "1人や協力で遊べる、新しいモードも準備中なのだ。",
   "face": "normal",
   "section": 4,
   "start": 118.512,
   "end": 122.629
  },
  {
   "who": "metan",
   "text": "対戦が苦手な人にも、うれしい話ね。",
   "face": "normal",
   "section": 4,
   "start": 122.879,
   "end": 125.557
  },
  {
   "who": "zundamon",
   "text": "クリスマス前の配信をめざしているのだ。",
   "face": "smile",
   "section": 4,
   "start": 125.807,
   "end": 128.484
  },
  {
   "who": "zundamon",
   "text": "最後は星座占いなのだ！イタコ、よろしくなのだ。",
   "face": "smile",
   "section": 5,
   "start": 129.284,
   "end": 133.156
  },
  {
   "who": "itako",
   "text": "今日の1位は、おとめ座ですわ。マフラーが幸運を呼びます。",
   "face": "smile",
   "section": 5,
   "start": 133.406,
   "end": 137.907
  },
  {
   "who": "itako",
   "text": "2位はかに座、3位はうお座です。",
   "face": "normal",
   "section": 5,
   "start": 138.157,
   "end": 140.6
  },
  {
   "who": "zundamon",
   "text": "雪のワールドにも、マフラーは似合いそうなのだ。",
   "face": "normal",
   "section": 5,
   "start": 140.85,
   "end": 144.007
  },
  {
   "who": "itako",
   "text": "12位はさそり座。温かい物で、心もほっこりしますわ。",
   "face": "normal",
   "section": 5,
   "start": 144.257,
   "end": 148.855
  },
  {
   "who": "zundamon",
   "text": "ラッキーアイテムは湯たんぽ…ぬくぬくなのだ。",
   "face": "smile",
   "section": 5,
   "start": 149.105,
   "end": 152.454
  },
  {
   "who": "metan",
   "text": "今日はここまで。いい日曜日にしなさいよね。",
   "face": "smile",
   "section": 6,
   "start": 153.254,
   "end": 156.145
  },
  {
   "who": "zundamon",
   "text": "みんな、また明日なのだ！",
   "face": "smile",
   "section": 6,
   "start": 156.395,
   "end": 158.336
  }
 ],
