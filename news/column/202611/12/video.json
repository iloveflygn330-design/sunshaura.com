 "lines": [
  {
   "who": "zundamon",
   "text": "おはようなのだ！ずんだもんのVRニュースの時間なのだ。",
   "face": "smile",
   "section": 0,
   "start": 0.6,
   "end": 4.504
  },
  {
   "who": "ankomon",
   "text": "今日はあんこもんも来てやったもん。",
   "face": "point",
   "section": 0,
   "start": 4.754,
   "end": 6.482
  },
  {
   "who": "zundamon",
   "text": "来てくれてうれしいのだ、あんこもん。",
   "face": "smile",
   "section": 0,
   "start": 6.732,
   "end": 9.143
  },
  {
   "who": "zundamon",
   "text": "11月12日のニュースは4本なのだ。",
   "face": "normal",
   "section": 0,
   "start": 9.393,
   "end": 12.774
  },
  {
   "who": "zundamon",
   "text": "1本目。VThanksというサービスのベータ版が始まったのだ。",
   "face": "normal",
   "section": 1,
   "start": 13.574,
   "end": 18.459
  },
  {
   "who": "zundamon",
   "text": "VRChatで出会ったクリエイターを、支援できるのだ。",
   "face": "normal",
   "section": 1,
   "start": 18.709,
   "end": 22.464
  },
  {
   "who": "ankomon",
   "text": "支援って、お金を送るってことだもん？",
   "face": "think",
   "section": 1,
   "start": 22.714,
   "end": 25.775
  },
  {
   "who": "zundamon",
   "text": "そうなのだ。感謝の気持ちを形にして届けるのだ。",
   "face": "normal",
   "section": 1,
   "start": 26.025,
   "end": 29.609
  },
  {
   "who": "zundamon",
   "text": "ライブやDJイベントのチケットも買えるのだ。",
   "face": "normal",
   "section": 1,
   "start": 29.859,
   "end": 32.846
  },
  {
   "who": "ankomon",
   "text": "主催する人も、販売ページを作れるの？",
   "face": "normal",
   "section": 1,
   "start": 33.096,
   "end": 36.253
  },
  {
   "who": "zundamon",
   "text": "作れるのだ。正式サービスは秋に始まる予定なのだ。",
   "face": "normal",
   "section": 1,
   "start": 36.503,
   "end": 40.493
  },
  {
   "who": "ankomon",
   "text": "あんこ好きのイベントにも使えそうだもん。",
   "face": "smile",
   "section": 1,
   "start": 40.743,
   "end": 42.919
  },
  {
   "who": "zundamon",
   "text": "2本目。家庭科のドラゴンが小説になったのだ。",
   "face": "normal",
   "section": 2,
   "start": 43.719,
   "end": 47.463
  },
  {
   "who": "ankomon",
   "text": "裁縫セットで見たことあるやつだもん！",
   "face": "surprise",
   "section": 2,
   "start": 47.713,
   "end": 49.857
  },
  {
   "who": "zundamon",
   "text": "その記念の対談が、VRChatで開かれるのだ。",
   "face": "normal",
   "section": 2,
   "start": 50.107,
   "end": 53.851
  },
  {
   "who": "zundamon",
   "text": "11月13日、金曜の夜8時からなのだ。",
   "face": "normal",
   "section": 2,
   "start": 54.101,
   "end": 58.005
  },
  {
   "who": "zundamon",
   "text": "著者さんや編集さんが、制作の裏話を話すのだ。",
   "face": "normal",
   "section": 2,
   "start": 58.255,
   "end": 62.255
  },
  {
   "who": "ankomon",
   "text": "VRを持ってない人はどうするの？",
   "face": "think",
   "section": 2,
   "start": 62.505,
   "end": 64.702
  },
  {
   "who": "zundamon",
   "text": "YouTubeでも配信されるから安心なのだ。",
   "face": "smile",
   "section": 2,
   "start": 64.952,
   "end": 67.811
  },
  {
   "who": "ankomon",
   "text": "試し読みもできるなんて、気が利いてるもん。",
   "face": "normal",
   "section": 2,
   "start": 68.061,
   "end": 71.069
  },
  {
   "who": "zundamon",
   "text": "3本目。Somnium SpaceがSteamに戻ってくるのだ。",
   "face": "normal",
   "section": 3,
   "start": 71.869,
   "end": 76.135
  },
  {
   "who": "ankomon",
   "text": "戻ってくるって、前はいなくなってたの？",
   "face": "look",
   "section": 3,
   "start": 76.385,
   "end": 79.201
  },
  {
   "who": "zundamon",
   "text": "土地をNFTで売っていて、Steamを離れていたのだ。",
   "face": "normal",
   "section": 3,
   "start": 79.451,
   "end": 83.302
  },
  {
   "who": "zundamon",
   "text": "12月に、基本無料の早期アクセスで出る予定なのだ。",
   "face": "normal",
   "section": 3,
   "start": 83.552,
   "end": 87.584
  },
  {
   "who": "zundamon",
   "text": "18歳以上向けで、年齢確認が必要なのだ。",
   "face": "normal",
   "section": 3,
   "start": 87.834,
   "end": 91.631
  },
  {
   "who": "ankomon",
   "text": "Steam版で使えないものもあるんだもん？",
   "face": "think",
   "section": 3,
   "start": 91.881,
   "end": 94.271
  },
  {
   "who": "zundamon",
   "text": "投げ銭のTip Jarは使えないそうなのだ。",
   "face": "normal",
   "section": 3,
   "start": 94.521,
   "end": 97.187
  },
  {
   "who": "ankomon",
   "text": "条件つきでも、帰ってこれてよかったね。",
   "face": "normal",
   "section": 3,
   "start": 97.437,
   "end": 100.435
  },
  {
   "who": "zundamon",
   "text": "4本目。弓で戦うIn Deathのモードが単体アプリになったのだ。",
   "face": "normal",
   "section": 4,
   "start": 101.235,
   "end": 106.024
  },
  {
   "who": "zundamon",
   "text": "Questで11.99ドルなのだ。",
   "face": "normal",
   "section": 4,
   "start": 106.274,
   "end": 109.271
  },
  {
   "who": "ankomon",
   "text": "そのモード、前は無料じゃなかったの？",
   "face": "surprise",
   "section": 4,
   "start": 109.521,
   "end": 112.284
  },
  {
   "who": "zundamon",
   "text": "今も本編の中なら無料で遊べるのだ。",
   "face": "normal",
   "section": 4,
   "start": 112.534,
   "end": 115.275
  },
  {
   "who": "zundamon",
   "text": "存在があまり知られてなくて、専用ページを作ったのだ。",
   "face": "normal",
   "section": 4,
   "start": 115.525,
   "end": 119.536
  },
  {
   "who": "ankomon",
   "text": "知られてないのは、つらいもん…。",
   "face": "think",
   "section": 4,
   "start": 119.786,
   "end": 122.005
  },
  {
   "who": "zundamon",
   "text": "単体版は90Hz対応や、新しいロビーも入ったのだ。",
   "face": "normal",
   "section": 4,
   "start": 122.255,
   "end": 126.799
  },
  {
   "who": "ankomon",
   "text": "目立つって大事なんだもん。",
   "face": "point",
   "section": 4,
   "start": 127.049,
   "end": 128.478
  },
  {
   "who": "zundamon",
   "text": "最後は星座占いなのだ！イタコ、お願いするのだ。",
   "face": "smile",
   "section": 5,
   "start": 129.278,
   "end": 133.289
  },
  {
   "who": "itako",
   "text": "今日の1位は、さそり座。応援の気持ちが届く日ですわ。",
   "face": "smile",
   "section": 5,
   "start": 133.539,
   "end": 137.848
  },
  {
   "who": "itako",
   "text": "2位はおとめ座、3位はやぎ座です。",
   "face": "normal",
   "section": 5,
   "start": 138.098,
   "end": 140.658
  },
  {
   "who": "zundamon",
   "text": "やぎ座のラッキーアイテムは、あんこの和菓子なのだ。",
   "face": "look",
   "section": 5,
   "start": 140.908,
   "end": 144.247
  },
  {
   "who": "itako",
   "text": "12位はしし座。ひと休みすれば運気が戻りますわ。",
   "face": "normal",
   "section": 5,
   "start": 144.497,
   "end": 148.251
  },
  {
   "who": "zundamon",
   "text": "ラッキーアイテムはずんだ餅なのだ！食べて元気になるのだ。",
   "face": "smile",
   "section": 5,
   "start": 148.501,
   "end": 152.8
  },
  {
   "who": "ankomon",
   "text": "今日はあんこが出てきたから、あんこもんの勝ちだもん。",
   "face": "point",
   "section": 6,
   "start": 153.6,
   "end": 156.715
  },
  {
   "who": "zundamon",
   "text": "ずんだ餅も出てきたから引き分けなのだ。また明日なのだ！",
   "face": "smile",
   "section": 6,
   "start": 156.965,
   "end": 160.751
  }
 ],
