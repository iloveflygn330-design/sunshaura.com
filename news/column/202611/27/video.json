 "lines": [
  {
   "who": "zundamon",
   "text": "みんな、おはようなのだ！ずんだもんなのだ。",
   "face": "smile",
   "section": 0,
   "start": 0.6,
   "end": 3.768
  },
  {
   "who": "zunko",
   "text": "ずんだもん、おはよう。今日もよろしくね。",
   "face": "smile",
   "section": 0,
   "start": 4.018,
   "end": 7.143
  },
  {
   "who": "zundamon",
   "text": "11月27日のVRニュースは4本なのだ。",
   "face": "normal",
   "section": 0,
   "start": 7.393,
   "end": 11.543
  },
  {
   "who": "zundamon",
   "text": "1本目。Vket2026 Winterの企業ブース第2弾が発表されたのだ。",
   "face": "normal",
   "section": 1,
   "start": 12.343,
   "end": 19.447
  },
  {
   "who": "zundamon",
   "text": "会期は12月5日から20日まで。VRChatで参加無料なのだ。",
   "face": "normal",
   "section": 1,
   "start": 19.697,
   "end": 25.051
  },
  {
   "who": "zunko",
   "text": "今回はどんな企業が出るの？",
   "face": "normal",
   "section": 1,
   "start": 25.301,
   "end": 27.296
  },
  {
   "who": "zundamon",
   "text": "富士急行は、絶望要塞がテーマの試練を用意してるのだ。",
   "face": "surprise",
   "section": 1,
   "start": 27.546,
   "end": 31.877
  },
  {
   "who": "zundamon",
   "text": "サントリーは巨大カニ鍋づくりと乾杯体験なのだ。",
   "face": "smile",
   "section": 1,
   "start": 32.127,
   "end": 35.711
  },
  {
   "who": "zunko",
   "text": "カニ鍋！みんなで作るの、楽しそうだね。",
   "face": "smile",
   "section": 1,
   "start": 35.961,
   "end": 39.299
  },
  {
   "who": "zundamon",
   "text": "ただし20歳以上が対象なのだ。",
   "face": "look",
   "section": 1,
   "start": 39.549,
   "end": 42.195
  },
  {
   "who": "zundamon",
   "text": "エヴァの新作XRゲームも出展するのだ！",
   "face": "normal",
   "section": 1,
   "start": 42.445,
   "end": 46.146
  },
  {
   "who": "zunko",
   "text": "開幕まで、あと少しだね。",
   "face": "normal",
   "section": 1,
   "start": 46.396,
   "end": 48.508
  },
  {
   "who": "zundamon",
   "text": "2本目。横浜のVR施設イマーシブジャーニーの新作なのだ。",
   "face": "normal",
   "section": 2,
   "start": 49.308,
   "end": 54.407
  },
  {
   "who": "zundamon",
   "text": "35億年の生き物の進化をたどる作品なのだ。",
   "face": "normal",
   "section": 2,
   "start": 54.657,
   "end": 58.721
  },
  {
   "who": "zunko",
   "text": "35億年！スケールが大きいね。",
   "face": "surprise",
   "section": 2,
   "start": 58.971,
   "end": 61.744
  },
  {
   "who": "zundamon",
   "text": "フランスの自然史博物館の科学者が監修してるのだ。",
   "face": "normal",
   "section": 2,
   "start": 61.994,
   "end": 65.738
  },
  {
   "who": "zunko",
   "text": "どれくらいの時間、体験できるの？",
   "face": "normal",
   "section": 2,
   "start": 65.988,
   "end": 68.591
  },
  {
   "who": "zundamon",
   "text": "約45分で、8歳以上が対象なのだ。",
   "face": "normal",
   "section": 2,
   "start": 68.841,
   "end": 72.371
  },
  {
   "who": "zundamon",
   "text": "公開は12月15日から。チケットはもう買えるのだ。",
   "face": "smile",
   "section": 2,
   "start": 72.621,
   "end": 76.632
  },
  {
   "who": "zunko",
   "text": "冬休みのお出かけにもよさそう。",
   "face": "normal",
   "section": 2,
   "start": 76.882,
   "end": 78.93
  },
  {
   "who": "zundamon",
   "text": "3本目。にじさんじの鈴木勝さんが360度配信をしたのだ。",
   "face": "normal",
   "section": 3,
   "start": 79.73,
   "end": 85.266
  },
  {
   "who": "zundamon",
   "text": "VRChatではなく、Unityで仕組みを自作したのだ。",
   "face": "surprise",
   "section": 3,
   "start": 85.516,
   "end": 89.356
  },
  {
   "who": "zunko",
   "text": "自分で作っちゃったの？すごいね。",
   "face": "surprise",
   "section": 3,
   "start": 89.606,
   "end": 92.017
  },
  {
   "who": "zundamon",
   "text": "PCやスマホ、Questでも周りを見渡せたのだ。",
   "face": "normal",
   "section": 3,
   "start": 92.267,
   "end": 95.861
  },
  {
   "who": "zundamon",
   "text": "飼っている猫ちゃんも登場したのだ。",
   "face": "smile",
   "section": 3,
   "start": 96.111,
   "end": 98.447
  },
  {
   "who": "zunko",
   "text": "猫ちゃんがいると、和むよね。",
   "face": "smile",
   "section": 3,
   "start": 98.697,
   "end": 100.948
  },
  {
   "who": "zundamon",
   "text": "クリスマスの配信も考えているそうなのだ。",
   "face": "normal",
   "section": 3,
   "start": 101.198,
   "end": 104.11
  },
  {
   "who": "zundamon",
   "text": "4本目。XREALのブラックフライデーセールなのだ。",
   "face": "normal",
   "section": 4,
   "start": 104.91,
   "end": 109.283
  },
  {
   "who": "zundamon",
   "text": "今日11月27日から12月7日までなのだ。",
   "face": "normal",
   "section": 4,
   "start": 109.533,
   "end": 113.693
  },
  {
   "who": "zunko",
   "text": "一番お得なのはどれ？",
   "face": "normal",
   "section": 4,
   "start": 113.943,
   "end": 115.586
  },
  {
   "who": "zundamon",
   "text": "Beam Proが30%オフで、20,780円からなのだ。",
   "face": "smile",
   "section": 4,
   "start": 115.836,
   "end": 121.073
  },
  {
   "who": "zundamon",
   "text": "でもXREAL AURAは対象外なのだ。",
   "face": "look",
   "section": 4,
   "start": 121.323,
   "end": 124.907
  },
  {
   "who": "zunko",
   "text": "在庫しだいで早く終わることもあるんだね。",
   "face": "normal",
   "section": 4,
   "start": 125.157,
   "end": 127.675
  },
  {
   "who": "zundamon",
   "text": "気になる人は早めにチェックなのだ。",
   "face": "normal",
   "section": 4,
   "start": 127.925,
   "end": 130.218
  },
  {
   "who": "zundamon",
   "text": "最後は星座占いなのだ！イタコ、よろしくなのだ。",
   "face": "smile",
   "section": 5,
   "start": 131.018,
   "end": 134.89
  },
  {
   "who": "itako",
   "text": "今日の1位は、ふたご座ですわ。ひらめきが形になる日です。",
   "face": "smile",
   "section": 5,
   "start": 135.14,
   "end": 139.567
  },
  {
   "who": "itako",
   "text": "2位はやぎ座、3位はおとめ座ですわ。",
   "face": "normal",
   "section": 5,
   "start": 139.817,
   "end": 142.526
  },
  {
   "who": "zundamon",
   "text": "ふたご座の人、何か作ってみるといいのだ！",
   "face": "normal",
   "section": 5,
   "start": 142.776,
   "end": 145.848
  },
  {
   "who": "itako",
   "text": "12位はさそり座。ひと休みすると良い流れになりますわ。",
   "face": "normal",
   "section": 5,
   "start": 146.098,
   "end": 150.599
  },
  {
   "who": "zundamon",
   "text": "あったか靴下で、のんびりするのだ〜。",
   "face": "normal",
   "section": 5,
   "start": 150.849,
   "end": 154.455
  },
  {
   "who": "zundamon",
   "text": "今日のニュースはここまでなのだ。",
   "face": "normal",
   "section": 6,
   "start": 155.255,
   "end": 157.228
  },
  {
   "who": "zunko",
   "text": "聞いてくれてありがとう。週末も楽しんでね。",
   "face": "smile",
   "section": 6,
   "start": 157.478,
   "end": 160.593
  },
  {
   "who": "zundamon",
   "text": "また明日なのだ！",
   "face": "smile",
   "section": 6,
   "start": 160.843,
   "end": 162.027
  }
 ],
