 "lines": [
  {
   "who": "zundamon",
   "text": "おはようなのだ！ずんだもんのVRニュースなのだ。",
   "face": "smile",
   "section": 0,
   "start": 0.6,
   "end": 4.013
  },
  {
   "who": "metan",
   "text": "おはよう。今日はわたくしが付き合ってあげるわ。",
   "face": "smile",
   "section": 0,
   "start": 4.263,
   "end": 6.93
  },
  {
   "who": "zundamon",
   "text": "めたん、よろしくなのだ。",
   "face": "normal",
   "section": 0,
   "start": 7.18,
   "end": 9.015
  },
  {
   "who": "zundamon",
   "text": "11月25日のニュースは5本なのだ。",
   "face": "normal",
   "section": 0,
   "start": 9.265,
   "end": 12.721
  },
  {
   "who": "zundamon",
   "text": "1本目。Vketに青山商事が出展するのだ。",
   "face": "normal",
   "section": 1,
   "start": 13.521,
   "end": 17.681
  },
  {
   "who": "zundamon",
   "text": "会期は12月5日から20日までなのだ。",
   "face": "normal",
   "section": 1,
   "start": 17.931,
   "end": 21.547
  },
  {
   "who": "metan",
   "text": "スーツのお店が、バーチャルで何をするのよ？",
   "face": "look",
   "section": 1,
   "start": 21.797,
   "end": 24.581
  },
  {
   "who": "zundamon",
   "text": "古着を集めて、木を育てるゲームなのだ。",
   "face": "smile",
   "section": 1,
   "start": 24.831,
   "end": 27.796
  },
  {
   "who": "zundamon",
   "text": "最大4人で、陣地を取り合うのだ。",
   "face": "normal",
   "section": 1,
   "start": 28.046,
   "end": 30.873
  },
  {
   "who": "zundamon",
   "text": "LINE登録で、アバター用のコートももらえるのだ。",
   "face": "normal",
   "section": 1,
   "start": 31.123,
   "end": 34.632
  },
  {
   "who": "metan",
   "text": "タダでコート？それは見逃せないわね。",
   "face": "surprise",
   "section": 1,
   "start": 34.882,
   "end": 37.346
  },
  {
   "who": "zundamon",
   "text": "入場も無料だから、気軽に行けるのだ。",
   "face": "normal",
   "section": 1,
   "start": 37.596,
   "end": 40.497
  },
  {
   "who": "zundamon",
   "text": "2本目。すてきなVRChatワールドの紹介なのだ。",
   "face": "normal",
   "section": 2,
   "start": 41.297,
   "end": 45.095
  },
  {
   "who": "zundamon",
   "text": "名前はWEATHER STATIONなのだ。",
   "face": "normal",
   "section": 2,
   "start": 45.345,
   "end": 47.809
  },
  {
   "who": "zundamon",
   "text": "草原にぽつんと建つ、小さな観測所なのだ。",
   "face": "normal",
   "section": 2,
   "start": 48.059,
   "end": 51.44
  },
  {
   "who": "metan",
   "text": "観測所って、何か観測できるの？",
   "face": "look",
   "section": 2,
   "start": 51.69,
   "end": 54.229
  },
  {
   "who": "zundamon",
   "text": "タブレットで天気を変えて、雷も落とせるのだ！",
   "face": "surprise",
   "section": 2,
   "start": 54.479,
   "end": 57.977
  },
  {
   "who": "metan",
   "text": "雷を自分で？ちょっと面白そうじゃない。",
   "face": "smile",
   "section": 2,
   "start": 58.227,
   "end": 61.065
  },
  {
   "who": "zundamon",
   "text": "夕暮れの雷雨が、おすすめだそうなのだ。",
   "face": "normal",
   "section": 2,
   "start": 61.315,
   "end": 64.163
  },
  {
   "who": "zundamon",
   "text": "3本目。VRMモデルがデスクトップで動くアプリなのだ。",
   "face": "normal",
   "section": 3,
   "start": 64.963,
   "end": 69.773
  },
  {
   "who": "zundamon",
   "text": "VRM Mateで、11月30日にSteamで発売なのだ。",
   "face": "normal",
   "section": 3,
   "start": 70.023,
   "end": 75.293
  },
  {
   "who": "zundamon",
   "text": "ウィンドウに座ったり、マウスを追いかけたりするのだ。",
   "face": "smile",
   "section": 3,
   "start": 75.543,
   "end": 78.881
  },
  {
   "who": "metan",
   "text": "それで、お値段はいくらなの？",
   "face": "anger",
   "section": 3,
   "start": 79.131,
   "end": 81.115
  },
  {
   "who": "zundamon",
   "text": "2200円で、発売記念で20%オフなのだ。",
   "face": "normal",
   "section": 3,
   "start": 81.365,
   "end": 86.005
  },
  {
   "who": "zundamon",
   "text": "ただ、キャラクターは付いてこないのだ。",
   "face": "look",
   "section": 3,
   "start": 86.255,
   "end": 88.847
  },
  {
   "who": "metan",
   "text": "自分の好きなモデルを呼べるなら、悪くないわ。",
   "face": "normal",
   "section": 3,
   "start": 89.097,
   "end": 91.764
  },
  {
   "who": "zundamon",
   "text": "4本目。Questの画面を映すアプリが強化されたのだ。",
   "face": "normal",
   "section": 4,
   "start": 92.564,
   "end": 96.873
  },
  {
   "who": "zundamon",
   "text": "Virtual Displayというアプリなのだ。",
   "face": "normal",
   "section": 4,
   "start": 97.123,
   "end": 99.438
  },
  {
   "who": "zundamon",
   "text": "ヘッドセットのカメラやマイクを、PCで使えるのだ。",
   "face": "normal",
   "section": 4,
   "start": 99.688,
   "end": 103.443
  },
  {
   "who": "metan",
   "text": "被ったまま、ビデオ通話もできるってこと？",
   "face": "surprise",
   "section": 4,
   "start": 103.693,
   "end": 106.434
  },
  {
   "who": "zundamon",
   "text": "そうなのだ。USBケーブルでもつなげるのだ。",
   "face": "normal",
   "section": 4,
   "start": 106.684,
   "end": 110.001
  },
  {
   "who": "zundamon",
   "text": "Wi-Fiが弱い場所でも、安心なのだ。",
   "face": "smile",
   "section": 4,
   "start": 110.251,
   "end": 113.078
  },
  {
   "who": "metan",
   "text": "地味だけど、毎日使う人にはうれしい話ね。",
   "face": "normal",
   "section": 4,
   "start": 113.328,
   "end": 116.315
  },
  {
   "who": "zundamon",
   "text": "5本目。ダンジョンゲームがPS VR2に来たのだ。",
   "face": "normal",
   "section": 5,
   "start": 117.115,
   "end": 121.968
  },
  {
   "who": "zundamon",
   "text": "One More Delveというゲームなのだ。",
   "face": "normal",
   "section": 5,
   "start": 122.218,
   "end": 125.589
  },
  {
   "who": "zundamon",
   "text": "剣や弓、魔法で戦うのだ。最大3人で協力できるのだ。",
   "face": "smile",
   "section": 5,
   "start": 125.839,
   "end": 130.735
  },
  {
   "who": "metan",
   "text": "3人で潜るなんて、わくわくするじゃない。",
   "face": "smile",
   "section": 5,
   "start": 130.985,
   "end": 133.481
  },
  {
   "who": "zundamon",
   "text": "ただ、オンラインにはPS Plusが要るのだ。",
   "face": "look",
   "section": 5,
   "start": 133.731,
   "end": 136.813
  },
  {
   "who": "metan",
   "text": "またお金がかかるのね…。",
   "face": "anger",
   "section": 5,
   "start": 137.063,
   "end": 138.386
  },
  {
   "who": "zundamon",
   "text": "ひとりでも遊べるから、大丈夫なのだ。",
   "face": "normal",
   "section": 5,
   "start": 138.636,
   "end": 141.409
  },
  {
   "who": "zundamon",
   "text": "最後は星座占いなのだ！イタコ、お願いするのだ。",
   "face": "smile",
   "section": 6,
   "start": 142.209,
   "end": 146.22
  },
  {
   "who": "itako",
   "text": "今日の1位は、かに座ですわ。身近な人の一言がヒントに。",
   "face": "smile",
   "section": 6,
   "start": 146.47,
   "end": 151.078
  },
  {
   "who": "itako",
   "text": "2位はいて座、3位はおとめ座です。",
   "face": "normal",
   "section": 6,
   "start": 151.328,
   "end": 154.923
  },
  {
   "who": "zundamon",
   "text": "かに座のみんな、おめでとうなのだ！",
   "face": "smile",
   "section": 6,
   "start": 155.173,
   "end": 157.637
  },
  {
   "who": "itako",
   "text": "12位はやぎ座。早めに休めば、明日は好調ですわ。",
   "face": "normal",
   "section": 6,
   "start": 157.887,
   "end": 162.857
  },
  {
   "who": "zundamon",
   "text": "ラッキーアイテムはブランケットなのだ。ぬくぬくするのだ。",
   "face": "normal",
   "section": 6,
   "start": 163.107,
   "end": 167.961
  },
  {
   "who": "metan",
   "text": "今日はここまで。また付き合ってあげてもいいわよ。",
   "face": "smile",
   "section": 7,
   "start": 168.761,
   "end": 171.694
  },
  {
   "who": "zundamon",
   "text": "また明日なのだ！",
   "face": "smile",
   "section": 7,
   "start": 171.944,
   "end": 173.128
  }
 ],
