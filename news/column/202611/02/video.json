 "lines": [
  {
   "who": "zundamon",
   "text": "おはようなのだ！今週もニュースを始めるのだ。",
   "face": "smile",
   "section": 0,
   "start": 0.6,
   "end": 3.747
  },
  {
   "who": "zunko",
   "text": "おはよう、ずんだもん。11月になったね。",
   "face": "smile",
   "section": 0,
   "start": 3.997,
   "end": 7.431
  },
  {
   "who": "zundamon",
   "text": "11月2日のニュースは4本なのだ。",
   "face": "normal",
   "section": 0,
   "start": 7.681,
   "end": 10.839
  },
  {
   "who": "zundamon",
   "text": "1本目。フルトラ用のルームウェアが発表されたのだ！",
   "face": "smile",
   "section": 1,
   "start": 11.639,
   "end": 15.457
  },
  {
   "who": "zunko",
   "text": "ルームウェア？トラッカーとどう関係あるの？",
   "face": "look",
   "section": 1,
   "start": 15.707,
   "end": 18.662
  },
  {
   "who": "zundamon",
   "text": "服にトラッカー用のベルトが縫い付けてあるのだ。",
   "face": "normal",
   "section": 1,
   "start": 18.912,
   "end": 21.92
  },
  {
   "who": "zundamon",
   "text": "体のあちこちにベルトを巻く手間がへるのだ。",
   "face": "normal",
   "section": 1,
   "start": 22.17,
   "end": 25.018
  },
  {
   "who": "zunko",
   "text": "それは助かるね。洗濯はできるのかな？",
   "face": "normal",
   "section": 1,
   "start": 25.268,
   "end": 28.297
  },
  {
   "who": "zundamon",
   "text": "トラッカーを外せば、洗濯機で洗えるのだ。",
   "face": "smile",
   "section": 1,
   "start": 28.547,
   "end": 31.758
  },
  {
   "who": "zundamon",
   "text": "クラファンは11月16日から始まる予定なのだ。",
   "face": "normal",
   "section": 1,
   "start": 32.008,
   "end": 36.115
  },
  {
   "who": "zunko",
   "text": "着たまま、くつろげそうでいいね。",
   "face": "smile",
   "section": 1,
   "start": 36.365,
   "end": 38.541
  },
  {
   "who": "zundamon",
   "text": "2本目。VRシューター『Forefront』なのだ。",
   "face": "normal",
   "section": 2,
   "start": 39.341,
   "end": 42.946
  },
  {
   "who": "zundamon",
   "text": "11月5日に、PS VR2で発売されるのだ！",
   "face": "surprise",
   "section": 2,
   "start": 43.196,
   "end": 47.559
  },
  {
   "who": "zunko",
   "text": "ほかの機種の人とも一緒に遊べるの？",
   "face": "normal",
   "section": 2,
   "start": 47.809,
   "end": 50.262
  },
  {
   "who": "zundamon",
   "text": "PCやQuestとクロスプレイできるのだ。",
   "face": "normal",
   "section": 2,
   "start": 50.512,
   "end": 53.552
  },
  {
   "who": "zundamon",
   "text": "トリガーやヘッドセットの振動にも対応なのだ。",
   "face": "normal",
   "section": 2,
   "start": 53.802,
   "end": 56.917
  },
  {
   "who": "zunko",
   "text": "手ごたえがあると、もっと夢中になれそう。",
   "face": "smile",
   "section": 2,
   "start": 57.167,
   "end": 60.004
  },
  {
   "who": "zundamon",
   "text": "3本目。『Dungeons Of Eternity』の更新なのだ。",
   "face": "normal",
   "section": 3,
   "start": 60.804,
   "end": 65.284
  },
  {
   "who": "zundamon",
   "text": "ハロウィンがテーマのアップデートなのだ。",
   "face": "smile",
   "section": 3,
   "start": 65.534,
   "end": 67.902
  },
  {
   "who": "zunko",
   "text": "どんなものが増えたの？",
   "face": "normal",
   "section": 3,
   "start": 68.152,
   "end": 69.56
  },
  {
   "who": "zundamon",
   "text": "吸血鬼の中ボスや、ミイラが出てくるのだ。",
   "face": "surprise",
   "section": 3,
   "start": 69.81,
   "end": 73.01
  },
  {
   "who": "zundamon",
   "text": "爆発するカボチャ頭のガイコツもいるのだ…。",
   "face": "look",
   "section": 3,
   "start": 73.26,
   "end": 76.097
  },
  {
   "who": "zunko",
   "text": "にぎやかだけど、ちょっと手ごわそうだね。",
   "face": "normal",
   "section": 3,
   "start": 76.347,
   "end": 78.982
  },
  {
   "who": "zundamon",
   "text": "人気のエリアも、ずっと遊べるようになったのだ。",
   "face": "smile",
   "section": 3,
   "start": 79.232,
   "end": 82.539
  },
  {
   "who": "zundamon",
   "text": "4本目。VRゲーム会社Schell Gamesの話なのだ。",
   "face": "normal",
   "section": 4,
   "start": 83.339,
   "end": 87.808
  },
  {
   "who": "zundamon",
   "text": "多くの社員を削減したことが分かったのだ。",
   "face": "surprise",
   "section": 4,
   "start": 88.058,
   "end": 91.567
  },
  {
   "who": "zunko",
   "text": "今年は、ほかのVRスタジオでも続いているんだよね。",
   "face": "surprise",
   "section": 4,
   "start": 91.817,
   "end": 95.529
  },
  {
   "who": "zundamon",
   "text": "そうなのだ。8月にも削減があったのだ。",
   "face": "normal",
   "section": 4,
   "start": 95.779,
   "end": 98.905
  },
  {
   "who": "zundamon",
   "text": "新作『Dragon Grove』は来年春の予定なのだ。",
   "face": "normal",
   "section": 4,
   "start": 99.155,
   "end": 103.101
  },
  {
   "who": "zunko",
   "text": "新作が無事に届くといいね。",
   "face": "normal",
   "section": 4,
   "start": 103.351,
   "end": 105.303
  },
  {
   "who": "zundamon",
   "text": "最後は星座占いなのだ。イタコ、よろしくなのだ！",
   "face": "smile",
   "section": 5,
   "start": 106.103,
   "end": 109.975
  },
  {
   "who": "itako",
   "text": "今日の1位は、ふたご座ですわ。新しい挑戦がうまくいきそうです。",
   "face": "smile",
   "section": 5,
   "start": 110.225,
   "end": 115.228
  },
  {
   "who": "itako",
   "text": "2位はやぎ座、3位はうお座ですわ。",
   "face": "normal",
   "section": 5,
   "start": 115.478,
   "end": 118.07
  },
  {
   "who": "zundamon",
   "text": "ふたご座のみんな、おめでとうなのだ！",
   "face": "smile",
   "section": 5,
   "start": 118.32,
   "end": 120.88
  },
  {
   "who": "itako",
   "text": "12位はみずがめ座。のんびりペースで大丈夫ですわ。",
   "face": "normal",
   "section": 5,
   "start": 121.13,
   "end": 125.29
  },
  {
   "who": "zundamon",
   "text": "あったかい靴下で、ゆっくりいくのだ。",
   "face": "look",
   "section": 5,
   "start": 125.54,
   "end": 128.303
  },
  {
   "who": "zunko",
   "text": "今日も聞いてくれてありがとう。",
   "face": "normal",
   "section": 6,
   "start": 129.103,
   "end": 130.841
  },
  {
   "who": "zundamon",
   "text": "また明日も見に来てほしいのだ！",
   "face": "smile",
   "section": 6,
   "start": 131.091,
   "end": 133.139
  }
 ],
