 "lines": [
  {
   "who": "zundamon",
   "text": "日曜日のVRニュース、始めるのだ！",
   "face": "smile",
   "section": 0,
   "start": 0.6,
   "end": 3.661
  },
  {
   "who": "metan",
   "text": "四国めたんよ。休みの朝くらい、ゆっくりさせなさいよね。",
   "face": "look",
   "section": 0,
   "start": 3.911,
   "end": 7.901
  },
  {
   "who": "zundamon",
   "text": "ゆっくり聞けばいいのだ。11月8日のニュースは3本なのだ！",
   "face": "normal",
   "section": 0,
   "start": 8.151,
   "end": 12.983
  },
  {
   "who": "zundamon",
   "text": "1本目。VRChatでボードゲームのお祭りが始まったのだ！",
   "face": "smile",
   "section": 1,
   "start": 13.783,
   "end": 18.615
  },
  {
   "who": "zundamon",
   "text": "バーチャルダイスパーティー2026、15日まで開催なのだ。",
   "face": "normal",
   "section": 1,
   "start": 18.865,
   "end": 23.387
  },
  {
   "who": "metan",
   "text": "ボードゲームって、VRの中でどうやって遊ぶの？",
   "face": "look",
   "section": 1,
   "start": 23.637,
   "end": 26.944
  },
  {
   "who": "zundamon",
   "text": "TRPGやボドゲを、VRで集まって遊ぶイベントなのだ。",
   "face": "normal",
   "section": 1,
   "start": 27.194,
   "end": 31.866
  },
  {
   "who": "zundamon",
   "text": "出展は204団体。大会や初心者向けの体験会もあるのだ！",
   "face": "surprise",
   "section": 1,
   "start": 32.116,
   "end": 37.556
  },
  {
   "who": "metan",
   "text": "で、入場料はおいくら？",
   "face": "anger",
   "section": 1,
   "start": 37.806,
   "end": 40.035
  },
  {
   "who": "zundamon",
   "text": "無料なのだ。VR機器がなくても、PCやスマホで入れるのだ。",
   "face": "smile",
   "section": 1,
   "start": 40.285,
   "end": 45.021
  },
  {
   "who": "metan",
   "text": "無料なら話は別ね。ちょっと覗いてみようかしら。",
   "face": "smile",
   "section": 1,
   "start": 45.271,
   "end": 48.365
  },
  {
   "who": "zundamon",
   "text": "2本目。Meta Questが、映画館モードを試しているのだ。",
   "face": "normal",
   "section": 2,
   "start": 49.165,
   "end": 53.325
  },
  {
   "who": "zundamon",
   "text": "テスト版のOSで、大きな画面で動画が見られるのだ。",
   "face": "normal",
   "section": 2,
   "start": 53.575,
   "end": 57.425
  },
  {
   "who": "metan",
   "text": "今までの画面と何が違うの？",
   "face": "look",
   "section": 2,
   "start": 57.675,
   "end": 59.606
  },
  {
   "who": "zundamon",
   "text": "見ている間は、ほかのウィンドウが隠れるのだ。",
   "face": "smile",
   "section": 2,
   "start": 59.856,
   "end": 62.949
  },
  {
   "who": "zundamon",
   "text": "YouTubeやDisney+でも動いたらしいのだ。",
   "face": "normal",
   "section": 2,
   "start": 63.199,
   "end": 66.719
  },
  {
   "who": "metan",
   "text": "映画館の気分を、タダで味わえるってわけね。",
   "face": "eat",
   "section": 2,
   "start": 66.969,
   "end": 69.924
  },
  {
   "who": "zundamon",
   "text": "でも正式に配られる日は、まだ決まってないのだ。",
   "face": "amazement",
   "section": 2,
   "start": 70.174,
   "end": 73.555
  },
  {
   "who": "zundamon",
   "text": "3本目。Quest版YouTubeの、新しい画面の話なのだ。",
   "face": "normal",
   "section": 3,
   "start": 74.355,
   "end": 79.091
  },
  {
   "who": "zundamon",
   "text": "動画を見ながら、別の窓で次の動画を探せるみたいなのだ。",
   "face": "surprise",
   "section": 3,
   "start": 79.341,
   "end": 83.533
  },
  {
   "who": "metan",
   "text": "それ、地味だけどかなり便利じゃない。",
   "face": "smile",
   "section": 3,
   "start": 83.783,
   "end": 85.97
  },
  {
   "who": "zundamon",
   "text": "窓の大きさも、自由に変えられるようになるのだ。",
   "face": "normal",
   "section": 3,
   "start": 86.22,
   "end": 89.601
  },
  {
   "who": "metan",
   "text": "で、いつ使えるようになるのよ？",
   "face": "look",
   "section": 3,
   "start": 89.851,
   "end": 92.251
  },
  {
   "who": "zundamon",
   "text": "まだ開発中で、出るかどうかも決まってないのだ。",
   "face": "amazement",
   "section": 3,
   "start": 92.501,
   "end": 96.832
  },
  {
   "who": "metan",
   "text": "期待しすぎないで、気長に待ちましょ。",
   "face": "normal",
   "section": 3,
   "start": 97.082,
   "end": 99.439
  },
  {
   "who": "zundamon",
   "text": "お待ちかね、星座占いなのだ。イタコ、よろしくなのだ！",
   "face": "smile",
   "section": 4,
   "start": 100.239,
   "end": 104.581
  },
  {
   "who": "itako",
   "text": "今日の1位はふたご座。仲間と遊ぶ時間が大吉ですわ。",
   "face": "smile",
   "section": 4,
   "start": 104.831,
   "end": 109.321
  },
  {
   "who": "itako",
   "text": "2位はやぎ座、3位はしし座です。",
   "face": "normal",
   "section": 4,
   "start": 109.571,
   "end": 113.049
  },
  {
   "who": "zundamon",
   "text": "仲間と遊ぶなら、ボードゲームにぴったりなのだ！",
   "face": "smile",
   "section": 4,
   "start": 113.299,
   "end": 116.552
  },
  {
   "who": "itako",
   "text": "12位はおうし座。よく休めば明日に力が出ますわ。",
   "face": "normal",
   "section": 4,
   "start": 116.802,
   "end": 121.154
  },
  {
   "who": "zundamon",
   "text": "ラッキーアイテムはずんだ餅なのだ。食べて休むのだ！",
   "face": "smile",
   "section": 4,
   "start": 121.404,
   "end": 124.924
  },
  {
   "who": "metan",
   "text": "無料のイベント、ちゃんと覚えておくわ。",
   "face": "normal",
   "section": 5,
   "start": 125.724,
   "end": 128.188
  },
  {
   "who": "zundamon",
   "text": "今日も聞いてくれてありがとうなのだ。また明日なのだ！",
   "face": "smile",
   "section": 5,
   "start": 128.438,
   "end": 131.894
  }
 ],
