 "lines": [
  {
   "who": "zundamon",
   "text": "おはようなのだ！今日もVRニュースを始めるのだ。",
   "face": "smile",
   "section": 0,
   "start": 0.6,
   "end": 4.067
  },
  {
   "who": "ankomon",
   "text": "あんこもんも来たもん。今日は負けないもん。",
   "face": "point",
   "section": 0,
   "start": 4.317,
   "end": 6.962
  },
  {
   "who": "zundamon",
   "text": "ニュースに勝ち負けはないのだ……。",
   "face": "amazement",
   "section": 0,
   "start": 7.212,
   "end": 9.079
  },
  {
   "who": "zundamon",
   "text": "11月19日のニュースは3本なのだ。",
   "face": "normal",
   "section": 0,
   "start": 9.329,
   "end": 12.753
  },
  {
   "who": "zundamon",
   "text": "1本目。VRChatがメンテナンスの予定を出したのだ。",
   "face": "normal",
   "section": 1,
   "start": 13.553,
   "end": 18.011
  },
  {
   "who": "zundamon",
   "text": "データベースのメンテナンスで、日にちは11月25日なのだ。",
   "face": "normal",
   "section": 1,
   "start": 18.261,
   "end": 23.253
  },
  {
   "who": "ankomon",
   "text": "何時ごろだもん？",
   "face": "think",
   "section": 1,
   "start": 23.503,
   "end": 24.623
  },
  {
   "who": "zundamon",
   "text": "日本時間だと、夜の7時から11時ごろなのだ。",
   "face": "normal",
   "section": 1,
   "start": 24.873,
   "end": 29.108
  },
  {
   "who": "ankomon",
   "text": "えっ、遊べなくなっちゃうの？",
   "face": "surprise",
   "section": 1,
   "start": 29.358,
   "end": 31.47
  },
  {
   "who": "zundamon",
   "text": "サービスは動き続ける予定なのだ。",
   "face": "normal",
   "section": 1,
   "start": 31.72,
   "end": 34.152
  },
  {
   "who": "zundamon",
   "text": "でも、短い中断が起きるかもしれないそうなのだ。",
   "face": "normal",
   "section": 1,
   "start": 34.402,
   "end": 37.954
  },
  {
   "who": "ankomon",
   "text": "夜のイベントの人は、覚えておくといいもん。",
   "face": "normal",
   "section": 1,
   "start": 38.204,
   "end": 41.223
  },
  {
   "who": "zundamon",
   "text": "2本目。Metaが、ほかの会社のゲームにお金を出しているのだ。",
   "face": "normal",
   "section": 2,
   "start": 42.023,
   "end": 46.353
  },
  {
   "who": "zundamon",
   "text": "その額は、1億2000万ドル以上なのだ！",
   "face": "surprise",
   "section": 2,
   "start": 46.603,
   "end": 49.803
  },
  {
   "who": "ankomon",
   "text": "すごい額だもん。あんこが山ほど買えるもん。",
   "face": "smile",
   "section": 2,
   "start": 50.053,
   "end": 53.189
  },
  {
   "who": "zundamon",
   "text": "ストアの売上も、去年と同じくらいで安定しているそうなのだ。",
   "face": "normal",
   "section": 2,
   "start": 53.439,
   "end": 57.663
  },
  {
   "who": "ankomon",
   "text": "どんなゲームが増えるんだもん？",
   "face": "think",
   "section": 2,
   "start": 57.913,
   "end": 59.567
  },
  {
   "who": "zundamon",
   "text": "来年の春に、VR Glassesという新しい機械が出るのだ。",
   "face": "normal",
   "section": 2,
   "start": 59.817,
   "end": 64.563
  },
  {
   "who": "zundamon",
   "text": "座って、手で遊ぶゲームが合うと考えているのだ。",
   "face": "normal",
   "section": 2,
   "start": 64.813,
   "end": 68.419
  },
  {
   "who": "ankomon",
   "text": "コントローラーなしで遊べるのは楽そうだもん。",
   "face": "normal",
   "section": 2,
   "start": 68.669,
   "end": 71.229
  },
  {
   "who": "zundamon",
   "text": "3本目。日本のVRアトラクションが、中東に行ったのだ。",
   "face": "normal",
   "section": 3,
   "start": 72.029,
   "end": 76.733
  },
  {
   "who": "zundamon",
   "text": "バーレーンのコミコンで、2つの作品を出したのだ。",
   "face": "normal",
   "section": 3,
   "start": 76.983,
   "end": 80.524
  },
  {
   "who": "ankomon",
   "text": "どんな作品だもん？",
   "face": "think",
   "section": 3,
   "start": 80.774,
   "end": 82.065
  },
  {
   "who": "zundamon",
   "text": "ウルトラマンのVRミュージアムと、忍者のアトラクションなのだ。",
   "face": "normal",
   "section": 3,
   "start": 82.315,
   "end": 86.528
  },
  {
   "who": "zundamon",
   "text": "忍者のほうは、最大6人のチームで妖魔と戦うのだ。",
   "face": "normal",
   "section": 3,
   "start": 86.778,
   "end": 91.247
  },
  {
   "who": "ankomon",
   "text": "忍者なら、あんこもんのほうが素早いもん。",
   "face": "point",
   "section": 3,
   "start": 91.497,
   "end": 94.356
  },
  {
   "who": "zundamon",
   "text": "これからは、まわりの国にも広げていくそうなのだ。",
   "face": "normal",
   "section": 3,
   "start": 94.606,
   "end": 97.998
  },
  {
   "who": "ankomon",
   "text": "日本のVRが世界で遊ばれるのはうれしいもん。",
   "face": "smile",
   "section": 3,
   "start": 98.248,
   "end": 101.907
  },
  {
   "who": "zundamon",
   "text": "最後は星座占いなのだ！イタコ、お願いするのだ。",
   "face": "smile",
   "section": 4,
   "start": 102.707,
   "end": 106.717
  },
  {
   "who": "itako",
   "text": "今日の1位は、かに座。思いきった一歩がうまくいきますわ。",
   "face": "smile",
   "section": 4,
   "start": 106.967,
   "end": 111.799
  },
  {
   "who": "itako",
   "text": "2位はおひつじ座、3位はてんびん座ですわ。",
   "face": "normal",
   "section": 4,
   "start": 112.049,
   "end": 116.06
  },
  {
   "who": "zundamon",
   "text": "上位の人、おめでとうなのだ！",
   "face": "normal",
   "section": 4,
   "start": 116.31,
   "end": 118.539
  },
  {
   "who": "itako",
   "text": "12位はおうし座。ひと休みすれば運が戻りますわ。",
   "face": "normal",
   "section": 4,
   "start": 118.789,
   "end": 123.472
  },
  {
   "who": "zundamon",
   "text": "ラッキーアイテムはずんだ餅なのだ！ぜひ食べてほしいのだ。",
   "face": "smile",
   "section": 4,
   "start": 123.722,
   "end": 127.989
  },
  {
   "who": "zundamon",
   "text": "今日のニュースはここまでなのだ。",
   "face": "normal",
   "section": 5,
   "start": 128.789,
   "end": 130.762
  },
  {
   "who": "ankomon",
   "text": "また来てやるもん。次も負けないもん。",
   "face": "point",
   "section": 5,
   "start": 131.012,
   "end": 133.636
  },
  {
   "who": "zundamon",
   "text": "また明日なのだ！",
   "face": "smile",
   "section": 5,
   "start": 133.886,
   "end": 135.07
  }
 ],
