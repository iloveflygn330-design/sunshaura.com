 "lines": [
  {
   "who": "zundamon",
   "text": "おはようなのだ！ずんだもんのVRニュースなのだ。",
   "face": "smile",
   "section": 0,
   "start": 0.6,
   "end": 4.013
  },
  {
   "who": "zunko",
   "text": "おはよう、ずんだもん。今日は祝日だね。",
   "face": "smile",
   "section": 0,
   "start": 4.263,
   "end": 7.495
  },
  {
   "who": "zundamon",
   "text": "11月23日のニュースは3本なのだ。",
   "face": "normal",
   "section": 0,
   "start": 7.745,
   "end": 11.383
  },
  {
   "who": "zundamon",
   "text": "1本目。VRChatに図書館のワールドができたのだ。",
   "face": "normal",
   "section": 1,
   "start": 12.183,
   "end": 16.247
  },
  {
   "who": "zundamon",
   "text": "サンリオのバーチャルピューロランドの中なのだ。",
   "face": "normal",
   "section": 1,
   "start": 16.497,
   "end": 19.27
  },
  {
   "who": "zunko",
   "text": "図書館？どんな本が読めるの？",
   "face": "surprise",
   "section": 1,
   "start": 19.52,
   "end": 21.973
  },
  {
   "who": "zundamon",
   "text": "MF文庫Jのラノベを、無料で試し読みできるのだ。",
   "face": "smile",
   "section": 1,
   "start": 22.223,
   "end": 26.095
  },
  {
   "who": "zundamon",
   "text": "ミニゲームや、クロミのライブもあるのだ。",
   "face": "normal",
   "section": 1,
   "start": 26.345,
   "end": 29.161
  },
  {
   "who": "zunko",
   "text": "VRの機械がなくても入れるのかな？",
   "face": "look",
   "section": 1,
   "start": 29.411,
   "end": 31.865
  },
  {
   "who": "zundamon",
   "text": "スマホからでも参加できるのだ！",
   "face": "normal",
   "section": 1,
   "start": 32.115,
   "end": 34.152
  },
  {
   "who": "zunko",
   "text": "それなら、おやつを食べながら読めそうだね。",
   "face": "smile",
   "section": 1,
   "start": 34.402,
   "end": 37.261
  },
  {
   "who": "zundamon",
   "text": "2本目。Steam Frameの話なのだ。",
   "face": "normal",
   "section": 2,
   "start": 38.061,
   "end": 40.919
  },
  {
   "who": "zundamon",
   "text": "単体で動く確認済みゲームが、300本を超えたのだ。",
   "face": "surprise",
   "section": 2,
   "start": 41.169,
   "end": 45.287
  },
  {
   "who": "zunko",
   "text": "すごい！それって全部VRのゲーム？",
   "face": "normal",
   "section": 2,
   "start": 45.537,
   "end": 48.438
  },
  {
   "who": "zundamon",
   "text": "312本のうち、VRは101本なのだ。",
   "face": "look",
   "section": 2,
   "start": 48.688,
   "end": 53.019
  },
  {
   "who": "zundamon",
   "text": "残りは、大きな画面で遊ぶふつうのゲームなのだ。",
   "face": "normal",
   "section": 2,
   "start": 53.269,
   "end": 56.874
  },
  {
   "who": "zunko",
   "text": "なるほど、映画館みたいに遊ぶんだね。",
   "face": "normal",
   "section": 2,
   "start": 57.124,
   "end": 59.908
  },
  {
   "who": "zundamon",
   "text": "VRの数がもっと増えてほしいのだ。",
   "face": "normal",
   "section": 2,
   "start": 60.158,
   "end": 62.761
  },
  {
   "who": "zundamon",
   "text": "3本目。PCのVRゲームが無料になったのだ。",
   "face": "smile",
   "section": 3,
   "start": 63.561,
   "end": 67.454
  },
  {
   "who": "zundamon",
   "text": "『ファイティング・ムーア』のリマスター版なのだ。",
   "face": "normal",
   "section": 3,
   "start": 67.704,
   "end": 71.064
  },
  {
   "who": "zunko",
   "text": "どんなゲームなの？",
   "face": "normal",
   "section": 3,
   "start": 71.314,
   "end": 72.487
  },
  {
   "who": "zundamon",
   "text": "ハンマーや弓で戦う、ファンタジーのアクションなのだ。",
   "face": "normal",
   "section": 3,
   "start": 72.737,
   "end": 76.289
  },
  {
   "who": "zundamon",
   "text": "でもQuestだけでは動かないのだ。",
   "face": "surprise",
   "section": 3,
   "start": 76.539,
   "end": 78.779
  },
  {
   "who": "zunko",
   "text": "じゃあ、PCにつないで遊ぶんだね。",
   "face": "normal",
   "section": 3,
   "start": 79.029,
   "end": 81.653
  },
  {
   "who": "zundamon",
   "text": "SSDに入れるのがおすすめなのだ。",
   "face": "normal",
   "section": 3,
   "start": 81.903,
   "end": 84.389
  },
  {
   "who": "zunko",
   "text": "無料なら、気軽に試せていいね。",
   "face": "smile",
   "section": 3,
   "start": 84.639,
   "end": 87.092
  },
  {
   "who": "zundamon",
   "text": "最後は星座占いなのだ！イタコ、よろしくなのだ。",
   "face": "smile",
   "section": 4,
   "start": 87.892,
   "end": 91.764
  },
  {
   "who": "itako",
   "text": "今日の1位はおとめ座。新しい本との出会いが吉ですわ。",
   "face": "smile",
   "section": 4,
   "start": 92.014,
   "end": 96.515
  },
  {
   "who": "itako",
   "text": "2位はかに座、3位はみずがめ座です。",
   "face": "normal",
   "section": 4,
   "start": 96.765,
   "end": 99.507
  },
  {
   "who": "zundamon",
   "text": "図書館ワールドに行くと、いいことありそうなのだ。",
   "face": "normal",
   "section": 4,
   "start": 99.757,
   "end": 103.106
  },
  {
   "who": "itako",
   "text": "12位はやぎ座。早めに寝ると、明日はきっと上向きですわ。",
   "face": "normal",
   "section": 4,
   "start": 103.356,
   "end": 108.561
  },
  {
   "who": "zundamon",
   "text": "やぎ座のみんな、今夜はゆっくり休むのだ。",
   "face": "normal",
   "section": 4,
   "start": 108.811,
   "end": 112.257
  },
  {
   "who": "zunko",
   "text": "今日も聞いてくれて、ありがとうございました。",
   "face": "smile",
   "section": 5,
   "start": 113.057,
   "end": 116.011
  },
  {
   "who": "zundamon",
   "text": "よい祝日を過ごすのだ。また明日なのだ！",
   "face": "smile",
   "section": 5,
   "start": 116.261,
   "end": 119.173
  }
 ],
