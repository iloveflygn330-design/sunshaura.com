 "lines": [
  {
   "who": "zundamon",
   "text": "おはようなのだ！金曜日のVRニュースなのだ。",
   "face": "smile",
   "section": 0,
   "start": 0.6,
   "end": 3.928
  },
  {
   "who": "zunko",
   "text": "おはよう、ずんだもん。今週もあと少しだね。",
   "face": "smile",
   "section": 0,
   "start": 4.178,
   "end": 7.687
  },
  {
   "who": "zundamon",
   "text": "11月20日のニュースは3本なのだ。",
   "face": "normal",
   "section": 0,
   "start": 7.937,
   "end": 11.148
  },
  {
   "who": "zundamon",
   "text": "1本目はバーチャルマーケットの話なのだ。",
   "face": "normal",
   "section": 1,
   "start": 11.948,
   "end": 15.159
  },
  {
   "who": "zundamon",
   "text": "2026 Winterの企業ブース第1弾が出たのだ。",
   "face": "normal",
   "section": 1,
   "start": 15.409,
   "end": 20.166
  },
  {
   "who": "zunko",
   "text": "どんな会社が出るの？",
   "face": "look",
   "section": 1,
   "start": 20.416,
   "end": 21.824
  },
  {
   "who": "zundamon",
   "text": "アース製薬は、きき湯の大浴場なのだ。",
   "face": "normal",
   "section": 1,
   "start": 22.074,
   "end": 25.135
  },
  {
   "who": "zundamon",
   "text": "肩こりをモンスターにして退治するゲームなのだ。",
   "face": "smile",
   "section": 1,
   "start": 25.385,
   "end": 28.404
  },
  {
   "who": "zunko",
   "text": "お風呂でモンスター退治？ちょっと楽しそう！",
   "face": "surprise",
   "section": 1,
   "start": 28.654,
   "end": 31.737
  },
  {
   "who": "zundamon",
   "text": "青山商事は服を集めて森を育てるゲームなのだ。",
   "face": "normal",
   "section": 1,
   "start": 31.987,
   "end": 35.901
  },
  {
   "who": "zundamon",
   "text": "会期は12月5日から20日、参加は無料なのだ。",
   "face": "normal",
   "section": 1,
   "start": 36.151,
   "end": 41.133
  },
  {
   "who": "zunko",
   "text": "16日間もあるなら、ゆっくり回れそうだね。",
   "face": "smile",
   "section": 1,
   "start": 41.383,
   "end": 44.657
  },
  {
   "who": "zundamon",
   "text": "2本目はDesktop Mateの新しいDLCなのだ。",
   "face": "normal",
   "section": 2,
   "start": 45.457,
   "end": 49.873
  },
  {
   "who": "zundamon",
   "text": "パソコンの画面にキャラクターがいるアプリなのだ。",
   "face": "normal",
   "section": 2,
   "start": 50.123,
   "end": 53.131
  },
  {
   "who": "zunko",
   "text": "今度は誰が来るの？",
   "face": "look",
   "section": 2,
   "start": 53.381,
   "end": 54.768
  },
  {
   "who": "zundamon",
   "text": "バーチャルアーティストのOИEなのだ。",
   "face": "normal",
   "section": 2,
   "start": 55.018,
   "end": 57.397
  },
  {
   "who": "zundamon",
   "text": "11月26日発売で、2,200円なのだ。",
   "face": "normal",
   "section": 2,
   "start": 57.647,
   "end": 61.753
  },
  {
   "who": "zunko",
   "text": "声もちゃんと入っているのかな？",
   "face": "normal",
   "section": 2,
   "start": 62.003,
   "end": 63.934
  },
  {
   "who": "zundamon",
   "text": "入っているのだ。IAと一緒に出すこともできるのだ。",
   "face": "smile",
   "section": 2,
   "start": 64.184,
   "end": 67.725
  },
  {
   "who": "zunko",
   "text": "画面の中がにぎやかになりそうだね。",
   "face": "smile",
   "section": 2,
   "start": 67.975,
   "end": 70.215
  },
  {
   "who": "zundamon",
   "text": "3本目は街づくりゲームのVR版なのだ。",
   "face": "normal",
   "section": 3,
   "start": 71.015,
   "end": 75.058
  },
  {
   "who": "zundamon",
   "text": "Outlanders VRが12月10日に出るのだ。",
   "face": "normal",
   "section": 3,
   "start": 75.308,
   "end": 79.639
  },
  {
   "who": "zunko",
   "text": "どの機械で遊べるの？",
   "face": "normal",
   "section": 3,
   "start": 79.889,
   "end": 81.414
  },
  {
   "who": "zundamon",
   "text": "Meta QuestとPC VRなのだ。",
   "face": "normal",
   "section": 3,
   "start": 81.664,
   "end": 84.501
  },
  {
   "who": "zundamon",
   "text": "住人を導いて、小さな村を町にしていくのだ。",
   "face": "normal",
   "section": 3,
   "start": 84.751,
   "end": 88.399
  },
  {
   "who": "zundamon",
   "text": "働く時間や食べ物の配給も決められるのだ。",
   "face": "look",
   "section": 3,
   "start": 88.649,
   "end": 91.828
  },
  {
   "who": "zunko",
   "text": "住んでいる人が幸せかも大事なんだね。",
   "face": "smile",
   "section": 3,
   "start": 92.078,
   "end": 94.691
  },
  {
   "who": "zundamon",
   "text": "PC向けの体験版はもう遊べるのだ。",
   "face": "smile",
   "section": 3,
   "start": 94.941,
   "end": 98.141
  },
  {
   "who": "zundamon",
   "text": "最後は星座占いなのだ。イタコ、よろしくなのだ！",
   "face": "smile",
   "section": 4,
   "start": 98.941,
   "end": 102.813
  },
  {
   "who": "itako",
   "text": "今日の1位はうお座。挑戦が実を結ぶ日ですわ。",
   "face": "smile",
   "section": 4,
   "start": 103.063,
   "end": 107.063
  },
  {
   "who": "itako",
   "text": "2位はふたご座、3位はやぎ座ですわね。",
   "face": "normal",
   "section": 4,
   "start": 107.313,
   "end": 111.121
  },
  {
   "who": "zundamon",
   "text": "うお座のラッキーアイテムは入浴剤なのだ！",
   "face": "surprise",
   "section": 4,
   "start": 111.371,
   "end": 114.518
  },
  {
   "who": "itako",
   "text": "12位はおとめ座。あたたかくして過ごしてくださいな。",
   "face": "normal",
   "section": 4,
   "start": 114.768,
   "end": 118.885
  },
  {
   "who": "zundamon",
   "text": "ブランケットにくるまれば大丈夫なのだ。",
   "face": "smile",
   "section": 4,
   "start": 119.135,
   "end": 121.685
  },
  {
   "who": "zundamon",
   "text": "今日のニュースはここまでなのだ。",
   "face": "normal",
   "section": 5,
   "start": 122.485,
   "end": 124.458
  },
  {
   "who": "zunko",
   "text": "週末もVRを楽しんでね。またね！",
   "face": "smile",
   "section": 5,
   "start": 124.708,
   "end": 128.271
  },
  {
   "who": "zundamon",
   "text": "また明日なのだ！",
   "face": "smile",
   "section": 5,
   "start": 128.521,
   "end": 129.705
  }
 ],
