 "lines": [
  {
   "who": "zundamon",
   "text": "おはようなのだ！ずんだもんのVRニュースなのだ。",
   "face": "smile",
   "section": 0,
   "start": 0.6,
   "end": 4.013
  },
  {
   "who": "ankomon",
   "text": "今日はあんこもんも来てあげたもん。",
   "face": "point",
   "section": 0,
   "start": 4.263,
   "end": 6.045
  },
  {
   "who": "zundamon",
   "text": "来てくれてうれしいのだ、あんこもん。",
   "face": "smile",
   "section": 0,
   "start": 6.295,
   "end": 8.705
  },
  {
   "who": "zundamon",
   "text": "11月5日のニュースは3本なのだ！",
   "face": "normal",
   "section": 0,
   "start": 8.955,
   "end": 12.155
  },
  {
   "who": "zundamon",
   "text": "1本目は、映画『超かぐや姫！』のライブの話なのだ。",
   "face": "normal",
   "section": 1,
   "start": 12.955,
   "end": 17.723
  },
  {
   "who": "zundamon",
   "text": "12月26日の夜9時から、無料で見られるのだ。",
   "face": "smile",
   "section": 1,
   "start": 17.973,
   "end": 21.941
  },
  {
   "who": "ankomon",
   "text": "無料？それってどこで見られるの？",
   "face": "think",
   "section": 1,
   "start": 22.191,
   "end": 24.879
  },
  {
   "who": "zundamon",
   "text": "YouTubeと、VRChatのワールドなのだ。",
   "face": "normal",
   "section": 1,
   "start": 25.129,
   "end": 28.457
  },
  {
   "who": "zundamon",
   "text": "VRChatでは全部で8回も公演があるのだ。",
   "face": "normal",
   "section": 1,
   "start": 28.707,
   "end": 32.601
  },
  {
   "who": "ankomon",
   "text": "8回もあれば、行ける時間がありそうだもん。",
   "face": "smile",
   "section": 1,
   "start": 32.851,
   "end": 35.944
  },
  {
   "who": "zundamon",
   "text": "ワールドはもう公開中で、下見もできるのだ。",
   "face": "look",
   "section": 1,
   "start": 36.194,
   "end": 39.511
  },
  {
   "who": "ankomon",
   "text": "じゃあ、ずんだもんより先に下見しておくもん！",
   "face": "point",
   "section": 1,
   "start": 39.761,
   "end": 42.716
  },
  {
   "who": "zundamon",
   "text": "2本目は、SteamVRのベータ版の更新なのだ。",
   "face": "normal",
   "section": 2,
   "start": 43.516,
   "end": 47.825
  },
  {
   "who": "zundamon",
   "text": "Steam Linkで遊ぶときの画質が良くなるのだ。",
   "face": "smile",
   "section": 2,
   "start": 48.075,
   "end": 51.467
  },
  {
   "who": "ankomon",
   "text": "Steam Linkって、何に使うものなの？",
   "face": "think",
   "section": 2,
   "start": 51.717,
   "end": 54.64
  },
  {
   "who": "zundamon",
   "text": "QuestなどでPCのVRを無線で遊ぶ仕組みなのだ。",
   "face": "normal",
   "section": 2,
   "start": 54.89,
   "end": 59.53
  },
  {
   "who": "zundamon",
   "text": "文字がくっきり、色もはっきり見えるのだ。",
   "face": "smile",
   "section": 2,
   "start": 59.78,
   "end": 62.724
  },
  {
   "who": "ankomon",
   "text": "ベータ版って、すぐ使えるの？",
   "face": "normal",
   "section": 2,
   "start": 62.974,
   "end": 65.363
  },
  {
   "who": "zundamon",
   "text": "Steamの設定で、ベータに切り替えれば使えるのだ。",
   "face": "normal",
   "section": 2,
   "start": 65.613,
   "end": 69.368
  },
  {
   "who": "ankomon",
   "text": "VRChatもきれいに見えたら、うれしいもん。",
   "face": "smile",
   "section": 2,
   "start": 69.618,
   "end": 72.765
  },
  {
   "who": "zundamon",
   "text": "3本目は、GoogleのAIと3Dの話なのだ。",
   "face": "normal",
   "section": 3,
   "start": 73.565,
   "end": 78.439
  },
  {
   "who": "zundamon",
   "text": "AIが書いた3Dのコードを、安全に使う仕組みなのだ。",
   "face": "normal",
   "section": 3,
   "start": 78.689,
   "end": 82.988
  },
  {
   "who": "ankomon",
   "text": "AIのコードって、危ないの？",
   "face": "surprise",
   "section": 3,
   "start": 83.238,
   "end": 85.723
  },
  {
   "who": "zundamon",
   "text": "そのまま動かすのは信用できない、という考えなのだ。",
   "face": "look",
   "section": 3,
   "start": 85.973,
   "end": 89.813
  },
  {
   "who": "zundamon",
   "text": "だから先に3Dファイルに変えて、それだけを届けるのだ。",
   "face": "normal",
   "section": 3,
   "start": 90.063,
   "end": 94.49
  },
  {
   "who": "ankomon",
   "text": "なるほど。ちゃんと考えてあるもん。",
   "face": "think",
   "section": 3,
   "start": 94.74,
   "end": 97.151
  },
  {
   "who": "zundamon",
   "text": "VR機器向けの部品もあるのだ。今は開発者向けなのだ。",
   "face": "normal",
   "section": 3,
   "start": 97.401,
   "end": 101.646
  },
  {
   "who": "zundamon",
   "text": "最後は星座占いなのだ！イタコ、お願いするのだ。",
   "face": "smile",
   "section": 4,
   "start": 102.446,
   "end": 106.457
  },
  {
   "who": "itako",
   "text": "今日の1位は、いて座のみなさんですわ。",
   "face": "smile",
   "section": 4,
   "start": 106.707,
   "end": 109.555
  },
  {
   "who": "itako",
   "text": "2位はおうし座、3位はみずがめ座です。",
   "face": "normal",
   "section": 4,
   "start": 109.805,
   "end": 112.599
  },
  {
   "who": "zundamon",
   "text": "いて座は、新しい場所の下見が大当たりなのだ！",
   "face": "surprise",
   "section": 4,
   "start": 112.849,
   "end": 116.188
  },
  {
   "who": "itako",
   "text": "12位はさそり座。甘いものでひと息ついてくださいね。",
   "face": "normal",
   "section": 4,
   "start": 116.438,
   "end": 120.246
  },
  {
   "who": "zundamon",
   "text": "ラッキーアイテムは、あんこのおやつなのだ。",
   "face": "look",
   "section": 4,
   "start": 120.496,
   "end": 123.312
  },
  {
   "who": "ankomon",
   "text": "あんこのおやつが当たりなら、今日はあんこもんの勝ちだもん！",
   "face": "point",
   "section": 5,
   "start": 124.112,
   "end": 127.429
  },
  {
   "who": "zundamon",
   "text": "勝ち負けじゃないのだ…。また明日なのだ！",
   "face": "smile",
   "section": 5,
   "start": 127.679,
   "end": 130.314
  }
 ],
