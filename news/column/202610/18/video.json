 "lines": [
  {
   "who": "zundamon",
   "text": "こんにちは、ずんだもんなのだ！日曜日のニュースなのだ。",
   "face": "smile",
   "section": 0,
   "start": 0.6,
   "end": 4.6
  },
  {
   "who": "metan",
   "text": "めたんよ。日曜だし、ゆるっと聞かせてもらうわ。",
   "face": "eat",
   "section": 0,
   "start": 4.85,
   "end": 8.178
  },
  {
   "who": "zundamon",
   "text": "10月18日のVRニュースは、4本なのだ。",
   "face": "normal",
   "section": 0,
   "start": 8.428,
   "end": 12.225
  },
  {
   "who": "zundamon",
   "text": "1本目。VRChatのベータ版に、新しいビルドが来たのだ。",
   "face": "smile",
   "section": 1,
   "start": 13.025,
   "end": 17.943
  },
  {
   "who": "metan",
   "text": "ベータ版って、正式版の前に試せるやつよね？",
   "face": "normal",
   "section": 1,
   "start": 18.193,
   "end": 21.478
  },
  {
   "who": "zundamon",
   "text": "そうなのだ。2026.4.1というバージョンなのだ。",
   "face": "normal",
   "section": 1,
   "start": 21.728,
   "end": 28.501
  },
  {
   "who": "zundamon",
   "text": "ワールドの中で、ログイン画面がまた出る不具合が直ったのだ。",
   "face": "normal",
   "section": 1,
   "start": 28.751,
   "end": 32.879
  },
  {
   "who": "metan",
   "text": "遊んでる最中にログイン画面？それは困るわね。",
   "face": "surprise",
   "section": 1,
   "start": 33.129,
   "end": 36.393
  },
  {
   "who": "zundamon",
   "text": "フレンド一覧や居場所の更新も、安定するそうなのだ。",
   "face": "normal",
   "section": 1,
   "start": 36.643,
   "end": 40.686
  },
  {
   "who": "zundamon",
   "text": "文字が四角く表示される問題も、一部直ったのだ。",
   "face": "normal",
   "section": 1,
   "start": 40.936,
   "end": 44.68
  },
  {
   "who": "metan",
   "text": "地味だけど、毎日使うところが直るのは助かるわ。",
   "face": "smile",
   "section": 1,
   "start": 44.93,
   "end": 48.109
  },
  {
   "who": "zundamon",
   "text": "2本目。VRChatで、TRPGの大きなイベントがあるのだ。",
   "face": "normal",
   "section": 2,
   "start": 48.909,
   "end": 54.029
  },
  {
   "who": "metan",
   "text": "TRPG？わたくし、そういうの得意よ。",
   "face": "look",
   "section": 2,
   "start": 54.279,
   "end": 57.628
  },
  {
   "who": "zundamon",
   "text": "名前は「バチャプレ」。11月の4日間で、68卓もあるのだ。",
   "face": "smile",
   "section": 2,
   "start": 57.878,
   "end": 63.307
  },
  {
   "who": "zundamon",
   "text": "参加は基本無料で、申込みは10月25日までなのだ。",
   "face": "normal",
   "section": 2,
   "start": 63.557,
   "end": 68.304
  },
  {
   "who": "metan",
   "text": "無料なのは大事ね。……優先チケットもあるの？",
   "face": "surprise",
   "section": 2,
   "start": 68.554,
   "end": 71.615
  },
  {
   "who": "zundamon",
   "text": "1500円で、各日数量限定なのだ。",
   "face": "normal",
   "section": 2,
   "start": 71.865,
   "end": 75.236
  },
  {
   "who": "metan",
   "text": "うっ……今月のお財布と相談するわ。",
   "face": "anger",
   "section": 2,
   "start": 75.486,
   "end": 78.121
  },
  {
   "who": "zundamon",
   "text": "初心者向けの案内会もあるから、安心なのだ。",
   "face": "normal",
   "section": 2,
   "start": 78.371,
   "end": 81.859
  },
  {
   "who": "zundamon",
   "text": "3本目。VRゲーム『I Am Your Beast VR』の話なのだ。",
   "face": "normal",
   "section": 3,
   "start": 82.659,
   "end": 90.467
  },
  {
   "who": "zundamon",
   "text": "拡張が来て、9ステージとエピローグが増えたのだ。",
   "face": "normal",
   "section": 3,
   "start": 90.717,
   "end": 94.333
  },
  {
   "who": "metan",
   "text": "発売からどれくらいで来たの？",
   "face": "normal",
   "section": 3,
   "start": 94.583,
   "end": 96.385
  },
  {
   "who": "zundamon",
   "text": "4週間なのだ。戦った相手側の視点で描かれるのだ。",
   "face": "normal",
   "section": 3,
   "start": 96.635,
   "end": 100.731
  },
  {
   "who": "metan",
   "text": "敵側の話って、ちょっと気になるじゃない。",
   "face": "look",
   "section": 3,
   "start": 100.981,
   "end": 103.552
  },
  {
   "who": "zundamon",
   "text": "ただ、拡張の値段はまだ発表されていないのだ。",
   "face": "normal",
   "section": 3,
   "start": 103.802,
   "end": 107.386
  },
  {
   "who": "metan",
   "text": "そこ一番大事なところよ！",
   "face": "anger",
   "section": 3,
   "start": 107.636,
   "end": 109.332
  },
  {
   "who": "zundamon",
   "text": "4本目。VRパズル『Squingle Arcade』の更新なのだ。",
   "face": "normal",
   "section": 4,
   "start": 110.132,
   "end": 115.295
  },
  {
   "who": "zundamon",
   "text": "宇宙に浮かぶ迷路の、新しいエリアが追加されたのだ。",
   "face": "normal",
   "section": 4,
   "start": 115.545,
   "end": 119.395
  },
  {
   "who": "zundamon",
   "text": "本編に、無料で20ステージ増えたのだ。",
   "face": "smile",
   "section": 4,
   "start": 119.645,
   "end": 122.771
  },
  {
   "who": "metan",
   "text": "無料で増えるのは、えらいわね。",
   "face": "smile",
   "section": 4,
   "start": 123.021,
   "end": 124.93
  },
  {
   "who": "zundamon",
   "text": "待ち時間なしで遊べる、買い切り要素も出たのだ。",
   "face": "normal",
   "section": 4,
   "start": 125.18,
   "end": 128.7
  },
  {
   "who": "metan",
   "text": "待つか払うか……悩ましいところね。",
   "face": "look",
   "section": 4,
   "start": 128.95,
   "end": 131.254
  },
  {
   "who": "zundamon",
   "text": "ゲームは今後も、基本無料のままだそうなのだ。",
   "face": "normal",
   "section": 4,
   "start": 131.504,
   "end": 134.779
  },
  {
   "who": "zundamon",
   "text": "最後は星座占いなのだ！イタコ、お願いするのだ。",
   "face": "smile",
   "section": 5,
   "start": 135.579,
   "end": 139.589
  },
  {
   "who": "itako",
   "text": "今日の1位は、さそり座ですわ。集中力が冴えわたる日です。",
   "face": "smile",
   "section": 5,
   "start": 139.839,
   "end": 144.597
  },
  {
   "who": "itako",
   "text": "ラッキーアイテムは、砂時計ですわ。",
   "face": "normal",
   "section": 5,
   "start": 144.847,
   "end": 147.471
  },
  {
   "who": "itako",
   "text": "2位はふたご座、3位はおひつじ座です。",
   "face": "normal",
   "section": 5,
   "start": 147.721,
   "end": 151.454
  },
  {
   "who": "itako",
   "text": "12位はみずがめ座。早めに休めば、明日は好調ですわ。",
   "face": "normal",
   "section": 5,
   "start": 151.704,
   "end": 156.845
  },
  {
   "who": "zundamon",
   "text": "みずがめ座さん、今日は早寝するのだ〜。",
   "face": "normal",
   "section": 5,
   "start": 157.095,
   "end": 160.669
  },
  {
   "who": "zundamon",
   "text": "今日のニュースはここまでなのだ。",
   "face": "normal",
   "section": 6,
   "start": 161.469,
   "end": 163.442
  },
  {
   "who": "metan",
   "text": "くわしくは記事の出典を見てね。また聞いてあげるわ。",
   "face": "smile",
   "section": 6,
   "start": 163.692,
   "end": 166.839
  },
  {
   "who": "zundamon",
   "text": "また明日なのだ！",
   "face": "smile",
   "section": 6,
   "start": 167.089,
   "end": 168.273
  }
 ],
