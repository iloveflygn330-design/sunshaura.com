 "lines": [
  {
   "who": "zundamon",
   "text": "おはようなのだ！週明けのずんだもんなのだ。",
   "face": "smile",
   "section": 0,
   "start": 0.6,
   "end": 3.501
  },
  {
   "who": "zunko",
   "text": "ずんだもん、今週もよろしくね。",
   "face": "smile",
   "section": 0,
   "start": 3.751,
   "end": 6.13
  },
  {
   "who": "zundamon",
   "text": "10月19日のVRニュースは、4本なのだ。",
   "face": "normal",
   "section": 0,
   "start": 6.38,
   "end": 10.007
  },
  {
   "who": "zundamon",
   "text": "1本目。VRChatの通信サーバーのメンテなのだ。",
   "face": "normal",
   "section": 1,
   "start": 10.807,
   "end": 14.849
  },
  {
   "who": "zundamon",
   "text": "アメリカ西部のサーバーが対象なのだ。",
   "face": "normal",
   "section": 1,
   "start": 15.099,
   "end": 17.67
  },
  {
   "who": "zunko",
   "text": "いつごろ行われるの？",
   "face": "normal",
   "section": 1,
   "start": 17.92,
   "end": 19.456
  },
  {
   "who": "zundamon",
   "text": "日本時間の今日、17時から21時までなのだ。",
   "face": "normal",
   "section": 1,
   "start": 19.706,
   "end": 24.005
  },
  {
   "who": "zundamon",
   "text": "その間、インスタンスから切断されるかもしれないのだ。",
   "face": "surprise",
   "section": 1,
   "start": 24.255,
   "end": 28.073
  },
  {
   "who": "zunko",
   "text": "海外のフレンドと遊ぶときは、気をつけたいですね。",
   "face": "look",
   "section": 1,
   "start": 28.323,
   "end": 31.769
  },
  {
   "who": "zundamon",
   "text": "日本のサーバーは、明日の未明に別のメンテがあるのだ。",
   "face": "normal",
   "section": 1,
   "start": 32.019,
   "end": 35.965
  },
  {
   "who": "zundamon",
   "text": "2本目。Steam Next Festが今日から始まるのだ。",
   "face": "smile",
   "section": 2,
   "start": 36.765,
   "end": 40.904
  },
  {
   "who": "zunko",
   "text": "新作の体験版を、無料で遊べるお祭りですよね。",
   "face": "normal",
   "section": 2,
   "start": 41.154,
   "end": 44.898
  },
  {
   "who": "zundamon",
   "text": "そうなのだ。26日まで開かれるのだ。",
   "face": "normal",
   "section": 2,
   "start": 45.148,
   "end": 48.167
  },
  {
   "who": "zundamon",
   "text": "VRホラー『Rustmourne』の体験版も出ているのだ。",
   "face": "normal",
   "section": 2,
   "start": 48.417,
   "end": 52.182
  },
  {
   "who": "zunko",
   "text": "ホラーかあ……ちょっとドキドキしますね。",
   "face": "surprise",
   "section": 2,
   "start": 52.432,
   "end": 54.928
  },
  {
   "who": "zundamon",
   "text": "製品版は、2027年の前半が目安なのだ。",
   "face": "normal",
   "section": 2,
   "start": 55.178,
   "end": 59.21
  },
  {
   "who": "zundamon",
   "text": "ほかにも、PCのVR体験版がいろいろあるのだ。",
   "face": "normal",
   "section": 2,
   "start": 59.46,
   "end": 63.343
  },
  {
   "who": "zunko",
   "text": "週末までに、いくつか試してみたいな。",
   "face": "smile",
   "section": 2,
   "start": 63.593,
   "end": 66.569
  },
  {
   "who": "zundamon",
   "text": "3本目。協力プレイのVRシューターの話なのだ。",
   "face": "normal",
   "section": 3,
   "start": 67.369,
   "end": 71.294
  },
  {
   "who": "zundamon",
   "text": "ぬいぐるみのクマになって、女の子を守るのだ。",
   "face": "normal",
   "section": 3,
   "start": 71.544,
   "end": 74.851
  },
  {
   "who": "zunko",
   "text": "クマさんが主人公なんて、かわいいですね。",
   "face": "smile",
   "section": 3,
   "start": 75.101,
   "end": 78.087
  },
  {
   "who": "zundamon",
   "text": "Steamでは、11月3日発売と表示されたのだ。",
   "face": "normal",
   "section": 3,
   "start": 78.337,
   "end": 82.316
  },
  {
   "who": "zundamon",
   "text": "4人まで一緒に遊べて、Questともつながるのだ。",
   "face": "normal",
   "section": 3,
   "start": 82.566,
   "end": 86.129
  },
  {
   "who": "zunko",
   "text": "お値段はいくらなんですか？",
   "face": "normal",
   "section": 3,
   "start": 86.379,
   "end": 88.107
  },
  {
   "who": "zundamon",
   "text": "それが、まだ発表されていないのだ。",
   "face": "amazement",
   "section": 3,
   "start": 88.357,
   "end": 90.949
  },
  {
   "who": "zunko",
   "text": "体験版で、先に雰囲気をつかむのが良さそうですね。",
   "face": "normal",
   "section": 3,
   "start": 91.199,
   "end": 94.9
  },
  {
   "who": "zundamon",
   "text": "4本目はAIのニュースなのだ。",
   "face": "normal",
   "section": 4,
   "start": 95.7,
   "end": 98.377
  },
  {
   "who": "zundamon",
   "text": "Anthropicが、公益基金を作ると発表したのだ。",
   "face": "normal",
   "section": 4,
   "start": 98.627,
   "end": 102.414
  },
  {
   "who": "zunko",
   "text": "公益基金って、どういうものなの？",
   "face": "look",
   "section": 4,
   "start": 102.664,
   "end": 105.363
  },
  {
   "who": "zundamon",
   "text": "社会のための取り組みを、支援するお金なのだ。",
   "face": "normal",
   "section": 4,
   "start": 105.613,
   "end": 108.962
  },
  {
   "who": "zundamon",
   "text": "会社の株の5%を、この基金に充てるのだ。",
   "face": "normal",
   "section": 4,
   "start": 109.212,
   "end": 113.191
  },
  {
   "who": "zundamon",
   "text": "誰が支援先を決めるかは、これから発表なのだ。",
   "face": "normal",
   "section": 4,
   "start": 113.441,
   "end": 116.993
  },
  {
   "who": "zunko",
   "text": "どんな使われ方をするのか、続報を待ちたいですね。",
   "face": "normal",
   "section": 4,
   "start": 117.243,
   "end": 120.763
  },
  {
   "who": "zundamon",
   "text": "最後は星座占いなのだ！イタコ、よろしくなのだ。",
   "face": "smile",
   "section": 5,
   "start": 121.563,
   "end": 125.435
  },
  {
   "who": "itako",
   "text": "今日の1位は、しし座ですわ。新しい挑戦がうまく運びます。",
   "face": "smile",
   "section": 5,
   "start": 125.685,
   "end": 130.495
  },
  {
   "who": "itako",
   "text": "ラッキーアイテムは、ゲームの体験版ですわ。",
   "face": "normal",
   "section": 5,
   "start": 130.745,
   "end": 133.945
  },
  {
   "who": "itako",
   "text": "2位はおとめ座、3位はうお座です。",
   "face": "normal",
   "section": 5,
   "start": 134.195,
   "end": 137.758
  },
  {
   "who": "itako",
   "text": "12位はふたご座。早めに休めば、明日は上向きですわ。",
   "face": "normal",
   "section": 5,
   "start": 138.008,
   "end": 143.011
  },
  {
   "who": "zundamon",
   "text": "ふたご座のラッキーアイテムは、ずんだ餅なのだ！",
   "face": "normal",
   "section": 5,
   "start": 143.261,
   "end": 146.898
  },
  {
   "who": "zundamon",
   "text": "今日のニュースはここまでなのだ。",
   "face": "normal",
   "section": 6,
   "start": 147.698,
   "end": 149.671
  },
  {
   "who": "zunko",
   "text": "くわしくは記事の出典も見てみてね。",
   "face": "smile",
   "section": 6,
   "start": 149.921,
   "end": 152.172
  },
  {
   "who": "zundamon",
   "text": "それじゃあ、また明日なのだ！",
   "face": "smile",
   "section": 6,
   "start": 152.422,
   "end": 154.502
  }
 ],
