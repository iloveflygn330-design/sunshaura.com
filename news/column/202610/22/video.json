 "lines": [
  {
   "who": "zundamon",
   "text": "おはようなのだ！ずんだもんのニュースの時間なのだ。",
   "face": "smile",
   "section": 0,
   "start": 0.6,
   "end": 3.96
  },
  {
   "who": "ankomon",
   "text": "今日はあんこもんが来てやったもん。",
   "face": "point",
   "section": 0,
   "start": 4.21,
   "end": 5.927
  },
  {
   "who": "zundamon",
   "text": "よろしくなのだ、あんこもん。",
   "face": "smile",
   "section": 0,
   "start": 6.177,
   "end": 8.097
  },
  {
   "who": "zundamon",
   "text": "10月22日のVRニュースは、4本なのだ。",
   "face": "normal",
   "section": 0,
   "start": 8.347,
   "end": 12.113
  },
  {
   "who": "zundamon",
   "text": "1本目。VRChatの公式Wikiがメンテナンスしていたのだ。",
   "face": "normal",
   "section": 1,
   "start": 12.913,
   "end": 17.766
  },
  {
   "who": "ankomon",
   "text": "えっ、VRChatに入れなくなってたの？",
   "face": "surprise",
   "section": 1,
   "start": 18.016,
   "end": 20.821
  },
  {
   "who": "zundamon",
   "text": "違うのだ。止まったのはWikiだけなのだ。",
   "face": "normal",
   "section": 1,
   "start": 21.071,
   "end": 23.759
  },
  {
   "who": "zundamon",
   "text": "昨日の14時ごろから、今朝の4時半すぎまでだったのだ。",
   "face": "normal",
   "section": 1,
   "start": 24.009,
   "end": 27.86
  },
  {
   "who": "ankomon",
   "text": "なんでメンテしてたの？",
   "face": "think",
   "section": 1,
   "start": 28.11,
   "end": 29.358
  },
  {
   "who": "zundamon",
   "text": "理由は、公式からは発表されていないのだ。",
   "face": "look",
   "section": 1,
   "start": 29.608,
   "end": 32.861
  },
  {
   "who": "zundamon",
   "text": "もう終わっているから、今は普通に見られるのだ。",
   "face": "smile",
   "section": 1,
   "start": 33.111,
   "end": 36.333
  },
  {
   "who": "ankomon",
   "text": "それなら安心だもん。",
   "face": "normal",
   "section": 1,
   "start": 36.583,
   "end": 37.863
  },
  {
   "who": "zundamon",
   "text": "2本目。Questの新しいシステム更新、v2.9なのだ。",
   "face": "normal",
   "section": 2,
   "start": 38.663,
   "end": 43.687
  },
  {
   "who": "zundamon",
   "text": "日本でもMeta AIが使えるようになるのだ！",
   "face": "surprise",
   "section": 2,
   "start": 43.937,
   "end": 47.286
  },
  {
   "who": "ankomon",
   "text": "日本語でしゃべりかけてもいいの？",
   "face": "think",
   "section": 2,
   "start": 47.536,
   "end": 50.075
  },
  {
   "who": "zundamon",
   "text": "そうなのだ。日本語にも対応したのだ。",
   "face": "smile",
   "section": 2,
   "start": 50.325,
   "end": 53.055
  },
  {
   "who": "zundamon",
   "text": "ウィンドウは、壁に近づけると吸い付くようになったのだ。",
   "face": "normal",
   "section": 2,
   "start": 53.305,
   "end": 56.911
  },
  {
   "who": "zundamon",
   "text": "Quest 3と3Sは、QRコードも読めるのだ。",
   "face": "normal",
   "section": 2,
   "start": 57.161,
   "end": 61.054
  },
  {
   "who": "ankomon",
   "text": "あんこもんのQuestにも、もう来てる？",
   "face": "normal",
   "section": 2,
   "start": 61.304,
   "end": 63.779
  },
  {
   "who": "zundamon",
   "text": "少しずつ配信だから、届く日は人それぞれなのだ。",
   "face": "look",
   "section": 2,
   "start": 64.029,
   "end": 67.623
  },
  {
   "who": "zundamon",
   "text": "3本目。VRフィットネスのSupernaturalが再スタートなのだ。",
   "face": "normal",
   "section": 3,
   "start": 68.423,
   "end": 73.511
  },
  {
   "who": "zundamon",
   "text": "Metaから独立した会社が、早期アクセスで出したのだ。",
   "face": "normal",
   "section": 3,
   "start": 73.761,
   "end": 77.452
  },
  {
   "who": "ankomon",
   "text": "どんな運動をするの？",
   "face": "think",
   "section": 3,
   "start": 77.702,
   "end": 79.067
  },
  {
   "who": "zundamon",
   "text": "音楽に合わせて、的を打ったり、よけたりするのだ。",
   "face": "normal",
   "section": 3,
   "start": 79.317,
   "end": 83.104
  },
  {
   "who": "zundamon",
   "text": "月約20ドルか、年約200ドルの会員制なのだ。",
   "face": "normal",
   "section": 3,
   "start": 83.354,
   "end": 88.783
  },
  {
   "who": "zundamon",
   "text": "でも今は、アメリカとカナダだけなのだ…",
   "face": "amazement",
   "section": 3,
   "start": 89.033,
   "end": 92.543
  },
  {
   "who": "ankomon",
   "text": "日本に来たら、あんこもんの方がたくさん動くもん！",
   "face": "point",
   "section": 3,
   "start": 92.793,
   "end": 96.793
  },
  {
   "who": "zundamon",
   "text": "そのときは勝負なのだ！",
   "face": "smile",
   "section": 3,
   "start": 97.043,
   "end": 98.675
  },
  {
   "who": "zundamon",
   "text": "4本目。SnapのARグラス「Specs」の話なのだ。",
   "face": "normal",
   "section": 4,
   "start": 99.475,
   "end": 104.488
  },
  {
   "who": "zundamon",
   "text": "俳優のロバート・ダウニー・Jr.さんが参加するのだ！",
   "face": "surprise",
   "section": 4,
   "start": 104.738,
   "end": 109.346
  },
  {
   "who": "ankomon",
   "text": "え、映画の人がメガネを作るの？",
   "face": "surprise",
   "section": 4,
   "start": 109.596,
   "end": 112.241
  },
  {
   "who": "zundamon",
   "text": "名誉職として、体験やコンテンツ作りに関わるのだ。",
   "face": "normal",
   "section": 4,
   "start": 112.491,
   "end": 116.417
  },
  {
   "who": "zundamon",
   "text": "発売はこの秋、値段は2,195ドルからなのだ。",
   "face": "normal",
   "section": 4,
   "start": 116.667,
   "end": 121.36
  },
  {
   "who": "ankomon",
   "text": "た、高いもん…。日本では買えるの？",
   "face": "think",
   "section": 4,
   "start": 121.61,
   "end": 124.97
  },
  {
   "who": "zundamon",
   "text": "発売国はアメリカ、イギリス、フランスなのだ。",
   "face": "look",
   "section": 4,
   "start": 125.22,
   "end": 129.06
  },
  {
   "who": "zundamon",
   "text": "最後は星座占いなのだ！イタコ、よろしくなのだ。",
   "face": "smile",
   "section": 5,
   "start": 129.86,
   "end": 133.732
  },
  {
   "who": "itako",
   "text": "お任せくださいな。今日の1位は、いて座ですわ。",
   "face": "smile",
   "section": 5,
   "start": 133.982,
   "end": 137.811
  },
  {
   "who": "itako",
   "text": "新しい場所で良い出会いがありそう。ラッキーアイテムはスニーカーです。",
   "face": "normal",
   "section": 5,
   "start": 138.061,
   "end": 142.584
  },
  {
   "who": "itako",
   "text": "2位はかに座、3位はおうし座ですわ。",
   "face": "normal",
   "section": 5,
   "start": 142.834,
   "end": 146.493
  },
  {
   "who": "itako",
   "text": "12位はうお座。のんびり過ごせば運気は戻りますわ。",
   "face": "normal",
   "section": 5,
   "start": 146.743,
   "end": 151.009
  },
  {
   "who": "zundamon",
   "text": "うお座さん、ずんだ餅でひと休みするのだ～",
   "face": "smile",
   "section": 5,
   "start": 151.259,
   "end": 155.494
  },
  {
   "who": "zundamon",
   "text": "今日のニュースはここまでなのだ。くわしくは記事の出典を見てほしいのだ。",
   "face": "normal",
   "section": 6,
   "start": 156.294,
   "end": 160.998
  },
  {
   "who": "ankomon",
   "text": "明日も負けないもん。またね！",
   "face": "point",
   "section": 6,
   "start": 161.248,
   "end": 163.499
  },
  {
   "who": "zundamon",
   "text": "また明日なのだ！",
   "face": "smile",
   "section": 6,
   "start": 163.749,
   "end": 164.933
  }
 ],
