 "lines": [
  {
   "who": "zundamon",
   "text": "おはようなのだ！ずんだもんのVRニュースなのだ。",
   "face": "smile",
   "section": 0,
   "start": 0.6,
   "end": 4.013
  },
  {
   "who": "zunko",
   "text": "おはようございます。今日もよろしくね、ずんだもん。",
   "face": "smile",
   "section": 0,
   "start": 4.263,
   "end": 7.911
  },
  {
   "who": "zundamon",
   "text": "よろしくなのだ、ずん子！",
   "face": "normal",
   "section": 0,
   "start": 8.161,
   "end": 10.007
  },
  {
   "who": "zundamon",
   "text": "10月30日のニュースは、4本なのだ。",
   "face": "normal",
   "section": 0,
   "start": 10.257,
   "end": 13.467
  },
  {
   "who": "zundamon",
   "text": "1本目。VRChatの新しいバージョンが出たのだ。",
   "face": "normal",
   "section": 1,
   "start": 14.267,
   "end": 18.171
  },
  {
   "who": "zundamon",
   "text": "ベータだった表情の読み取りが、正式に入ったのだ！",
   "face": "smile",
   "section": 1,
   "start": 18.421,
   "end": 22.165
  },
  {
   "who": "zunko",
   "text": "わあ、顔の動きがアバターに出るんですね。",
   "face": "surprise",
   "section": 1,
   "start": 22.415,
   "end": 25.391
  },
  {
   "who": "zundamon",
   "text": "専用の機械がなくても、Webカメラで試せるのだ。",
   "face": "normal",
   "section": 1,
   "start": 25.641,
   "end": 29.321
  },
  {
   "who": "zundamon",
   "text": "ただ、アバター側の対応も必要なのだ。",
   "face": "look",
   "section": 1,
   "start": 29.571,
   "end": 32.633
  },
  {
   "who": "zundamon",
   "text": "スマホのQRコードで、PCにログインもできるのだ。",
   "face": "normal",
   "section": 1,
   "start": 32.883,
   "end": 36.733
  },
  {
   "who": "zunko",
   "text": "それは便利！ほかに注意することはありますか？",
   "face": "smile",
   "section": 1,
   "start": 36.983,
   "end": 40.418
  },
  {
   "who": "zundamon",
   "text": "古いバージョンの人とは会えないのだ。更新するのだ！",
   "face": "surprise",
   "section": 1,
   "start": 40.668,
   "end": 44.188
  },
  {
   "who": "zunko",
   "text": "友だちと遊ぶ前に、アップデートですね。",
   "face": "normal",
   "section": 1,
   "start": 44.438,
   "end": 47.339
  },
  {
   "who": "zundamon",
   "text": "2本目。ワールドに評価ボタンが付くことになったのだ。",
   "face": "normal",
   "section": 2,
   "start": 48.139,
   "end": 51.841
  },
  {
   "who": "zundamon",
   "text": "高評価と低評価で、目標は2026年中なのだ。",
   "face": "normal",
   "section": 2,
   "start": 52.091,
   "end": 56.677
  },
  {
   "who": "zunko",
   "text": "評価は、どんなふうに使われるんですか？",
   "face": "look",
   "section": 2,
   "start": 56.927,
   "end": 59.85
  },
  {
   "who": "zundamon",
   "text": "おすすめのワールドを選ぶのに使う予定なのだ。",
   "face": "normal",
   "section": 2,
   "start": 60.1,
   "end": 63.172
  },
  {
   "who": "zundamon",
   "text": "AIで作ったことを示すラベルは、付けないそうなのだ。",
   "face": "normal",
   "section": 2,
   "start": 63.422,
   "end": 67.251
  },
  {
   "who": "zunko",
   "text": "たくさんのアンケートを見て決めたんですね。",
   "face": "normal",
   "section": 2,
   "start": 67.501,
   "end": 69.816
  },
  {
   "who": "zundamon",
   "text": "2万件以上の回答があったのだ。すごいのだ。",
   "face": "surprise",
   "section": 2,
   "start": 70.066,
   "end": 73.394
  },
  {
   "who": "zunko",
   "text": "すてきなワールドが見つけやすくなるといいな。",
   "face": "smile",
   "section": 2,
   "start": 73.644,
   "end": 76.161
  },
  {
   "who": "zundamon",
   "text": "3本目。VRChatでライブの再演があるのだ。",
   "face": "normal",
   "section": 3,
   "start": 76.961,
   "end": 81.164
  },
  {
   "who": "zundamon",
   "text": "FZMZの「DEEP:DAWN」なのだ。",
   "face": "normal",
   "section": 3,
   "start": 81.414,
   "end": 84.369
  },
  {
   "who": "zunko",
   "text": "いつ見られるんですか？",
   "face": "look",
   "section": 3,
   "start": 84.619,
   "end": 86.027
  },
  {
   "who": "zundamon",
   "text": "11月5日と7日、どちらも夜6時からなのだ。",
   "face": "normal",
   "section": 3,
   "start": 86.277,
   "end": 90.586
  },
  {
   "who": "zundamon",
   "text": "チケットはいらなくて、無料なのだ！",
   "face": "smile",
   "section": 3,
   "start": 90.836,
   "end": 93.3
  },
  {
   "who": "zunko",
   "text": "無料なんて、うれしいですね！",
   "face": "smile",
   "section": 3,
   "start": 93.55,
   "end": 95.715
  },
  {
   "who": "zundamon",
   "text": "でも、PCだけで、Questでは入れないのだ。",
   "face": "look",
   "section": 3,
   "start": 95.965,
   "end": 99.453
  },
  {
   "who": "zundamon",
   "text": "アカウント作りとチュートリアルは、先に済ませるのだ。",
   "face": "normal",
   "section": 3,
   "start": 99.703,
   "end": 103.309
  },
  {
   "who": "zundamon",
   "text": "4本目。ARグラスのXreal Auraが値下げなのだ。",
   "face": "normal",
   "section": 4,
   "start": 104.109,
   "end": 109.165
  },
  {
   "who": "zundamon",
   "text": "アメリカで、最大200ドル安くなったのだ。",
   "face": "normal",
   "section": 4,
   "start": 109.415,
   "end": 112.604
  },
  {
   "who": "zunko",
   "text": "前に買った人は、ちょっと残念ですね。",
   "face": "surprise",
   "section": 4,
   "start": 112.854,
   "end": 115.585
  },
  {
   "who": "zundamon",
   "text": "大丈夫なのだ。差額を返してくれるそうなのだ。",
   "face": "smile",
   "section": 4,
   "start": 115.835,
   "end": 119.195
  },
  {
   "who": "zundamon",
   "text": "10月28日より前に払った人が対象なのだ。",
   "face": "normal",
   "section": 4,
   "start": 119.445,
   "end": 123.231
  },
  {
   "who": "zunko",
   "text": "それなら安心ですね。届くのはいつごろですか？",
   "face": "normal",
   "section": 4,
   "start": 123.481,
   "end": 126.884
  },
  {
   "who": "zundamon",
   "text": "11月の中ごろから、順番に出荷なのだ。",
   "face": "normal",
   "section": 4,
   "start": 127.134,
   "end": 130.601
  },
  {
   "who": "zundamon",
   "text": "僕のずんだ餅も、値下げしてほしいのだ。",
   "face": "look",
   "section": 4,
   "start": 130.851,
   "end": 133.741
  },
  {
   "who": "zundamon",
   "text": "最後は星座占いなのだ！イタコ、よろしくなのだ。",
   "face": "smile",
   "section": 5,
   "start": 134.541,
   "end": 138.413
  },
  {
   "who": "itako",
   "text": "お任せくださいな。今日の1位は、やぎ座ですわ。",
   "face": "smile",
   "section": 5,
   "start": 138.663,
   "end": 142.482
  },
  {
   "who": "itako",
   "text": "2位はかに座、3位はおとめ座です。",
   "face": "normal",
   "section": 5,
   "start": 142.732,
   "end": 145.281
  },
  {
   "who": "zundamon",
   "text": "やぎ座の人、おめでとうなのだ！",
   "face": "smile",
   "section": 5,
   "start": 145.531,
   "end": 147.814
  },
  {
   "who": "itako",
   "text": "12位はうお座。早寝をすれば、明日は絶好調ですわ。",
   "face": "normal",
   "section": 5,
   "start": 148.064,
   "end": 152.469
  },
  {
   "who": "zundamon",
   "text": "僕も今日は早く寝るのだ……。",
   "face": "look",
   "section": 5,
   "start": 152.719,
   "end": 155.055
  },
  {
   "who": "zunko",
   "text": "今日も聞いてくれて、ありがとうございました。",
   "face": "smile",
   "section": 6,
   "start": 155.855,
   "end": 158.81
  },
  {
   "who": "zundamon",
   "text": "また明日なのだ！",
   "face": "smile",
   "section": 6,
   "start": 159.06,
   "end": 160.244
  }
 ],
