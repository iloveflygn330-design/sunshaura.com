 "lines": [
  {
   "who": "zundamon",
   "text": "おはようなのだ！水曜日のニュースを始めるのだ。",
   "face": "smile",
   "section": 0,
   "start": 0.6,
   "end": 3.928
  },
  {
   "who": "metan",
   "text": "おはよう。今日はわたくしが聞いてあげるわ。",
   "face": "normal",
   "section": 0,
   "start": 4.178,
   "end": 6.653
  },
  {
   "who": "zundamon",
   "text": "10月28日のニュースは4本。音楽フェスの話からなのだ。",
   "face": "normal",
   "section": 0,
   "start": 6.903,
   "end": 11.735
  },
  {
   "who": "zundamon",
   "text": "1本目。VRChatの音楽フェス「ESPERA」なのだ。",
   "face": "normal",
   "section": 1,
   "start": 12.535,
   "end": 16.791
  },
  {
   "who": "zundamon",
   "text": "11月20日から3日間、VRChatで開かれるのだ。",
   "face": "normal",
   "section": 1,
   "start": 17.041,
   "end": 21.777
  },
  {
   "who": "zundamon",
   "text": "最終日22日の出演者、9組が発表されたのだ！",
   "face": "smile",
   "section": 1,
   "start": 22.027,
   "end": 26.933
  },
  {
   "who": "metan",
   "text": "へえ、豪華じゃない。でも、お高いんでしょ？",
   "face": "look",
   "section": 1,
   "start": 27.183,
   "end": 30.501
  },
  {
   "who": "zundamon",
   "text": "20日と21日は無料。最終日だけ有料なのだ。",
   "face": "normal",
   "section": 1,
   "start": 30.751,
   "end": 35.209
  },
  {
   "who": "zundamon",
   "text": "配信は3000円、会場に入るなら4000円なのだ。",
   "face": "normal",
   "section": 1,
   "start": 35.459,
   "end": 39.95
  },
  {
   "who": "metan",
   "text": "……わたくしは、まず無料の日から行くわ。",
   "face": "anger",
   "section": 1,
   "start": 40.2,
   "end": 42.376
  },
  {
   "who": "zundamon",
   "text": "賢い作戦なのだ。出演者の続報も待つのだ。",
   "face": "normal",
   "section": 1,
   "start": 42.626,
   "end": 46.295
  },
  {
   "who": "zundamon",
   "text": "2本目。新しいアバター「うる」が出るのだ。",
   "face": "normal",
   "section": 2,
   "start": 47.095,
   "end": 50.423
  },
  {
   "who": "zundamon",
   "text": "10月29日に、BOOTHで発売なのだ。",
   "face": "normal",
   "section": 2,
   "start": 50.673,
   "end": 53.991
  },
  {
   "who": "zundamon",
   "text": "ふわっと浮いた耳が特徴の、やわらかい感じの子なのだ。",
   "face": "smile",
   "section": 2,
   "start": 54.241,
   "end": 58.198
  },
  {
   "who": "metan",
   "text": "耳が浮いてるの？どうなってるのよ、それ。",
   "face": "surprise",
   "section": 2,
   "start": 58.448,
   "end": 61.243
  },
  {
   "who": "zundamon",
   "text": "フルトラッキングや、揺れものの設定にも対応なのだ。",
   "face": "normal",
   "section": 2,
   "start": 61.493,
   "end": 65.375
  },
  {
   "who": "zundamon",
   "text": "11月19日までに買うと、特典も付くのだ。",
   "face": "normal",
   "section": 2,
   "start": 65.625,
   "end": 69.327
  },
  {
   "who": "metan",
   "text": "特典付きは悪くないわね。改変が楽しみだわ。",
   "face": "smile",
   "section": 2,
   "start": 69.577,
   "end": 72.798
  },
  {
   "who": "zundamon",
   "text": "3本目。ソニーの「XYN」がアップデートしたのだ。",
   "face": "normal",
   "section": 3,
   "start": 73.598,
   "end": 76.777
  },
  {
   "who": "zundamon",
   "text": "写真から、本物そっくりの3DCGを作れる道具なのだ。",
   "face": "normal",
   "section": 3,
   "start": 77.027,
   "end": 81.56
  },
  {
   "who": "zundamon",
   "text": "写真は500枚まで。計算はクラウドでやってくれるのだ。",
   "face": "normal",
   "section": 3,
   "start": 81.81,
   "end": 85.938
  },
  {
   "who": "metan",
   "text": "じゃあ、パソコンが弱くても使えるってこと？",
   "face": "normal",
   "section": 3,
   "start": 86.188,
   "end": 89.228
  },
  {
   "who": "zundamon",
   "text": "そうなのだ。ガラスや細い柵も、きれいに出せるそうなのだ。",
   "face": "smile",
   "section": 3,
   "start": 89.478,
   "end": 93.787
  },
  {
   "who": "metan",
   "text": "ふうん。料金はいくらなの？",
   "face": "look",
   "section": 3,
   "start": 94.037,
   "end": 96.288
  },
  {
   "who": "zundamon",
   "text": "無料プランと、月3300円からのプランがあるのだ。",
   "face": "normal",
   "section": 3,
   "start": 96.538,
   "end": 100.773
  },
  {
   "who": "metan",
   "text": "まずは無料ね。それしかないわ。",
   "face": "anger",
   "section": 3,
   "start": 101.023,
   "end": 103.028
  },
  {
   "who": "zundamon",
   "text": "4本目。Apple Vision Proのスポーツ中継なのだ。",
   "face": "normal",
   "section": 4,
   "start": 103.828,
   "end": 107.497
  },
  {
   "who": "zundamon",
   "text": "試合の得点や時計が、立体で空間に浮かぶのだ。",
   "face": "surprise",
   "section": 4,
   "start": 107.747,
   "end": 111.715
  },
  {
   "who": "zundamon",
   "text": "野球だと、打順や成績が横に並んで見えるのだ。",
   "face": "normal",
   "section": 4,
   "start": 111.965,
   "end": 115.795
  },
  {
   "who": "metan",
   "text": "それ、試合中に数字が変わっても大丈夫なの？",
   "face": "normal",
   "section": 4,
   "start": 116.045,
   "end": 119.181
  },
  {
   "who": "zundamon",
   "text": "その場でデータを更新して表示できるそうなのだ。",
   "face": "normal",
   "section": 4,
   "start": 119.431,
   "end": 122.567
  },
  {
   "who": "metan",
   "text": "見ながら成績を確かめられるのは便利ね。",
   "face": "smile",
   "section": 4,
   "start": 122.817,
   "end": 125.238
  },
  {
   "who": "zundamon",
   "text": "どの試合で使われたかは、まだ非公開なのだ。",
   "face": "look",
   "section": 4,
   "start": 125.488,
   "end": 128.773
  },
  {
   "who": "zundamon",
   "text": "最後は星座占いなのだ！イタコ、よろしくなのだ。",
   "face": "smile",
   "section": 5,
   "start": 129.573,
   "end": 133.445
  },
  {
   "who": "itako",
   "text": "今日の1位は、さそり座ですわ。集中した分だけ成果が出ます。",
   "face": "smile",
   "section": 5,
   "start": 133.695,
   "end": 138.613
  },
  {
   "who": "itako",
   "text": "2位はおうし座、3位はみずがめ座です。",
   "face": "normal",
   "section": 5,
   "start": 138.863,
   "end": 141.657
  },
  {
   "who": "zundamon",
   "text": "おいしいものが元気をくれるなら、ずんだ餅なのだ！",
   "face": "smile",
   "section": 5,
   "start": 141.907,
   "end": 145.385
  },
  {
   "who": "itako",
   "text": "12位はおとめ座。深呼吸ひとつで流れが変わりますわ。",
   "face": "normal",
   "section": 5,
   "start": 145.635,
   "end": 150.125
  },
  {
   "who": "zundamon",
   "text": "ラッキーアイテムはミントのお菓子なのだ。すーっとするのだ。",
   "face": "normal",
   "section": 5,
   "start": 150.375,
   "end": 155.399
  },
  {
   "who": "metan",
   "text": "今日もおつかれさま。また来てあげるわ。",
   "face": "smile",
   "section": 6,
   "start": 156.199,
   "end": 158.407
  },
  {
   "who": "zundamon",
   "text": "めたん、ありがとうなのだ。また明日なのだ！",
   "face": "smile",
   "section": 6,
   "start": 158.657,
   "end": 161.857
  }
 ],
