 "lines": [
  {
   "who": "zundamon",
   "text": "おはようなのだ！今日もVRニュースの時間なのだ。",
   "face": "smile",
   "section": 0,
   "start": 0.6,
   "end": 4.067
  },
  {
   "who": "ankomon",
   "text": "あんこもんも来たもん。今日はしっかり聞いてやるもん。",
   "face": "point",
   "section": 0,
   "start": 4.317,
   "end": 7.527
  },
  {
   "who": "zundamon",
   "text": "ありがとうなのだ、あんこもん。",
   "face": "smile",
   "section": 0,
   "start": 7.777,
   "end": 9.857
  },
  {
   "who": "zundamon",
   "text": "10月29日のニュースは、4本なのだ。",
   "face": "normal",
   "section": 0,
   "start": 10.107,
   "end": 13.339
  },
  {
   "who": "zundamon",
   "text": "1本目。指の動きを読み取るVRグローブが公開されたのだ。",
   "face": "normal",
   "section": 1,
   "start": 14.139,
   "end": 19.409
  },
  {
   "who": "zundamon",
   "text": "名前は「EOZ VR Gloves」なのだ。",
   "face": "normal",
   "section": 1,
   "start": 19.659,
   "end": 23.051
  },
  {
   "who": "ankomon",
   "text": "指一本ずつ動くってこと？",
   "face": "think",
   "section": 1,
   "start": 23.301,
   "end": 25.103
  },
  {
   "who": "zundamon",
   "text": "そうなのだ。関節ごとの曲がり具合までわかるのだ。",
   "face": "smile",
   "section": 1,
   "start": 25.353,
   "end": 28.895
  },
  {
   "who": "zundamon",
   "text": "VRChatの指の入力にも対応しているのだ。",
   "face": "normal",
   "section": 1,
   "start": 29.145,
   "end": 33.027
  },
  {
   "who": "zundamon",
   "text": "手の位置はTundra Trackerで取るのだ。",
   "face": "normal",
   "section": 1,
   "start": 33.277,
   "end": 36.072
  },
  {
   "who": "ankomon",
   "text": "お値段はいくらなの？",
   "face": "look",
   "section": 1,
   "start": 36.322,
   "end": 37.613
  },
  {
   "who": "zundamon",
   "text": "300ドルで、発売は近日なのだ。日本は未定なのだ。",
   "face": "normal",
   "section": 1,
   "start": 37.863,
   "end": 42.449
  },
  {
   "who": "ankomon",
   "text": "指先まで動いたら、あんこもんのピースも決まるもん。",
   "face": "point",
   "section": 1,
   "start": 42.699,
   "end": 46.23
  },
  {
   "who": "zundamon",
   "text": "2本目。ソニーが小さな立体ディスプレイを出すのだ。",
   "face": "normal",
   "section": 2,
   "start": 47.03,
   "end": 50.977
  },
  {
   "who": "zundamon",
   "text": "「ELF-MN1」という名前で、画面は6インチなのだ。",
   "face": "normal",
   "section": 2,
   "start": 51.227,
   "end": 55.536
  },
  {
   "who": "ankomon",
   "text": "立体って、メガネがいるんでしょ？",
   "face": "think",
   "section": 2,
   "start": 55.786,
   "end": 58.239
  },
  {
   "who": "zundamon",
   "text": "いらないのだ！目の位置を読み取って立体に見せるのだ。",
   "face": "surprise",
   "section": 2,
   "start": 58.489,
   "end": 62.009
  },
  {
   "who": "zundamon",
   "text": "アバターやキャラクターも表示できるのだ。",
   "face": "normal",
   "section": 2,
   "start": 62.259,
   "end": 64.745
  },
  {
   "who": "ankomon",
   "text": "机にあんこもんを飾れるってことだもん。",
   "face": "smile",
   "section": 2,
   "start": 64.995,
   "end": 67.299
  },
  {
   "who": "zundamon",
   "text": "発売は12月11日。5万4千円前後の見込みなのだ。",
   "face": "normal",
   "section": 2,
   "start": 67.549,
   "end": 72.711
  },
  {
   "who": "zundamon",
   "text": "ずんだ餅を立体で飾るのも、ありなのだ。",
   "face": "smile",
   "section": 2,
   "start": 72.961,
   "end": 75.959
  },
  {
   "who": "zundamon",
   "text": "3本目。Steam Frameの話なのだ。",
   "face": "normal",
   "section": 3,
   "start": 76.759,
   "end": 79.777
  },
  {
   "who": "zundamon",
   "text": "外付けのCDドライブが使えないって質問があったのだ。",
   "face": "normal",
   "section": 3,
   "start": 80.027,
   "end": 84.123
  },
  {
   "who": "zundamon",
   "text": "Valveの人が「確認する」と答えたのだ。",
   "face": "normal",
   "section": 3,
   "start": 84.373,
   "end": 87.275
  },
  {
   "who": "zundamon",
   "text": "そのすぐあと、CDを認識する設定が追加されたのだ。",
   "face": "surprise",
   "section": 3,
   "start": 87.525,
   "end": 91.706
  },
  {
   "who": "ankomon",
   "text": "はやっ！じゃあもう使えるの？",
   "face": "surprise",
   "section": 3,
   "start": 91.956,
   "end": 94.079
  },
  {
   "who": "zundamon",
   "text": "まだ配信前なのだ。時期も決まっていないのだ。",
   "face": "look",
   "section": 3,
   "start": 94.329,
   "end": 97.625
  },
  {
   "who": "zundamon",
   "text": "それに、DVDの映像再生ができるわけではないのだ。",
   "face": "normal",
   "section": 3,
   "start": 97.875,
   "end": 102.013
  },
  {
   "who": "ankomon",
   "text": "でも、すぐ動いてくれるのはうれしいもん。",
   "face": "normal",
   "section": 3,
   "start": 102.263,
   "end": 105.101
  },
  {
   "who": "zundamon",
   "text": "4本目。『マリオ64』のMR版が話題なのだ。",
   "face": "normal",
   "section": 4,
   "start": 105.901,
   "end": 110.317
  },
  {
   "who": "zundamon",
   "text": "部屋の中に、ゲームの窓が浮かぶ感じなのだ。",
   "face": "normal",
   "section": 4,
   "start": 110.567,
   "end": 113.927
  },
  {
   "who": "zundamon",
   "text": "マリオをつまんで、机に置くこともできるのだ。",
   "face": "smile",
   "section": 4,
   "start": 114.177,
   "end": 117.43
  },
  {
   "who": "ankomon",
   "text": "それ、だれが作ったの？",
   "face": "think",
   "section": 4,
   "start": 117.68,
   "end": 119.739
  },
  {
   "who": "zundamon",
   "text": "開発者さんが、AIのClaudeを使って作ったのだ。",
   "face": "normal",
   "section": 4,
   "start": 119.989,
   "end": 123.946
  },
  {
   "who": "zundamon",
   "text": "PICOのヘッドセットで、90fpsで動くそうなのだ。",
   "face": "normal",
   "section": 4,
   "start": 124.196,
   "end": 128.239
  },
  {
   "who": "ankomon",
   "text": "遊べるのはいつなの？",
   "face": "look",
   "section": 4,
   "start": 128.489,
   "end": 129.865
  },
  {
   "who": "zundamon",
   "text": "公開の予定は、まだ発表されていないのだ。",
   "face": "normal",
   "section": 4,
   "start": 130.115,
   "end": 133.432
  },
  {
   "who": "ankomon",
   "text": "AIで作れるなら、あんこもんのゲームも作るもん！",
   "face": "point",
   "section": 4,
   "start": 133.682,
   "end": 136.989
  },
  {
   "who": "zundamon",
   "text": "最後は星座占いなのだ！イタコ、お願いするのだ。",
   "face": "smile",
   "section": 5,
   "start": 137.789,
   "end": 141.799
  },
  {
   "who": "itako",
   "text": "はい。今日の1位は、しし座ですわ。",
   "face": "smile",
   "section": 5,
   "start": 142.049,
   "end": 145.089
  },
  {
   "who": "itako",
   "text": "思い切った一歩が実を結ぶ日。ラッキーアイテムは赤いマグカップです。",
   "face": "normal",
   "section": 5,
   "start": 145.339,
   "end": 150.15
  },
  {
   "who": "itako",
   "text": "2位はうお座、3位はふたご座ですわ。",
   "face": "normal",
   "section": 5,
   "start": 150.4,
   "end": 154.048
  },
  {
   "who": "itako",
   "text": "12位はおうし座。甘いもので気分を上げてくださいね。",
   "face": "normal",
   "section": 5,
   "start": 154.298,
   "end": 158.533
  },
  {
   "who": "zundamon",
   "text": "ラッキーアイテムはずんだ餅なのだ！ぜひ食べてほしいのだ。",
   "face": "smile",
   "section": 5,
   "start": 158.783,
   "end": 163.049
  },
  {
   "who": "zundamon",
   "text": "今日はここまでなのだ。くわしくは記事の出典を見てほしいのだ。",
   "face": "normal",
   "section": 6,
   "start": 163.849,
   "end": 168.052
  },
  {
   "who": "ankomon",
   "text": "明日はもっと早く来てやるもん。またね！",
   "face": "point",
   "section": 6,
   "start": 168.302,
   "end": 171.15
  },
  {
   "who": "zundamon",
   "text": "また明日なのだ！",
   "face": "smile",
   "section": 6,
   "start": 171.4,
   "end": 172.584
  }
 ],
