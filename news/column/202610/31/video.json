 "lines": [
  {
   "who": "zundamon",
   "text": "こんにちは、ずんだもんなのだ！今日はハロウィンなのだ。",
   "face": "smile",
   "section": 0,
   "start": 0.6,
   "end": 4.291
  },
  {
   "who": "kiritan",
   "text": "きりたんです。仮装はしません。家から出ないので。",
   "face": "nihilistic",
   "section": 0,
   "start": 4.541,
   "end": 7.826
  },
  {
   "who": "zundamon",
   "text": "10月31日のVRニュースは4本なのだ。",
   "face": "normal",
   "section": 0,
   "start": 8.076,
   "end": 12.055
  },
  {
   "who": "zundamon",
   "text": "1本目。VRChatの即売会、メタフェス2026が今日から開幕なのだ！",
   "face": "smile",
   "section": 1,
   "start": 12.855,
   "end": 19.404
  },
  {
   "who": "kiritan",
   "text": "家から出ずに買い物できるイベント。最高ですね。",
   "face": "smile",
   "section": 1,
   "start": 19.654,
   "end": 22.79
  },
  {
   "who": "zundamon",
   "text": "800名以上のクリエイターが出展するのだ。",
   "face": "normal",
   "section": 1,
   "start": 23.04,
   "end": 26.144
  },
  {
   "who": "zundamon",
   "text": "アバターや衣装、ワールド、音楽まで並ぶのだ。",
   "face": "normal",
   "section": 1,
   "start": 26.394,
   "end": 30.117
  },
  {
   "who": "zundamon",
   "text": "会場は5つ。スマホから入れる会場もあるのだ。",
   "face": "normal",
   "section": 1,
   "start": 30.367,
   "end": 33.929
  },
  {
   "who": "kiritan",
   "text": "入場料はいくらなんですか？",
   "face": "look",
   "section": 1,
   "start": 34.179,
   "end": 35.961
  },
  {
   "who": "zundamon",
   "text": "無料なのだ！来場者には限定アイテムも配られるのだ。",
   "face": "normal",
   "section": 1,
   "start": 36.211,
   "end": 40.125
  },
  {
   "who": "zundamon",
   "text": "期間は11月8日まで。終わっても会場は残るのだ。",
   "face": "normal",
   "section": 1,
   "start": 40.375,
   "end": 44.503
  },
  {
   "who": "kiritan",
   "text": "財布の中身が先に終わらないよう、気をつけます。",
   "face": "nihilistic",
   "section": 1,
   "start": 44.753,
   "end": 47.857
  },
  {
   "who": "zundamon",
   "text": "2本目。タイタンフォール2のVR化MODが、対戦に対応なのだ。",
   "face": "normal",
   "section": 2,
   "start": 48.657,
   "end": 53.585
  },
  {
   "who": "kiritan",
   "text": "ロボットに乗るあのゲームですか。VRで対戦は熱いですね。",
   "face": "surprise",
   "section": 2,
   "start": 53.835,
   "end": 57.643
  },
  {
   "who": "zundamon",
   "text": "有志が作ったMODで、今はオープンベータなのだ。",
   "face": "normal",
   "section": 2,
   "start": 57.893,
   "end": 61.445
  },
  {
   "who": "zundamon",
   "text": "北米と欧州のサーバーで遊べるのだ。",
   "face": "normal",
   "section": 2,
   "start": 61.695,
   "end": 64.415
  },
  {
   "who": "kiritan",
   "text": "必要なものは何でしょう。",
   "face": "look",
   "section": 2,
   "start": 64.665,
   "end": 66.201
  },
  {
   "who": "zundamon",
   "text": "ゲーム本体と、VR対応のPCが必要なのだ。",
   "face": "normal",
   "section": 2,
   "start": 66.451,
   "end": 70.643
  },
  {
   "who": "zundamon",
   "text": "MOD自体は無料なのだ。",
   "face": "normal",
   "section": 2,
   "start": 70.893,
   "end": 72.643
  },
  {
   "who": "kiritan",
   "text": "非公式なので、導入は自己責任ですね。",
   "face": "normal",
   "section": 2,
   "start": 72.893,
   "end": 75.815
  },
  {
   "who": "zundamon",
   "text": "3本目。SFシューターのEXOSHOCKが、早期アクセスで発売なのだ。",
   "face": "normal",
   "section": 3,
   "start": 76.615,
   "end": 81.821
  },
  {
   "who": "zundamon",
   "text": "最大4人で協力して戦うゲームなのだ。",
   "face": "normal",
   "section": 3,
   "start": 82.071,
   "end": 85.121
  },
  {
   "who": "kiritan",
   "text": "対応する機種はどれですか？",
   "face": "look",
   "section": 3,
   "start": 85.371,
   "end": 87.131
  },
  {
   "who": "zundamon",
   "text": "Quest 3とPC VR、それにVRなしのPCでも遊べるのだ。",
   "face": "normal",
   "section": 3,
   "start": 87.381,
   "end": 92.651
  },
  {
   "who": "zundamon",
   "text": "全部の機種で、一緒に遊べるのだ。",
   "face": "normal",
   "section": 3,
   "start": 92.901,
   "end": 95.802
  },
  {
   "who": "kiritan",
   "text": "VRを持っていない友達も誘えますね。",
   "face": "smile",
   "section": 3,
   "start": 96.052,
   "end": 98.452
  },
  {
   "who": "zundamon",
   "text": "値段は19.99ドルなのだ。",
   "face": "normal",
   "section": 3,
   "start": 98.702,
   "end": 101.625
  },
  {
   "who": "zundamon",
   "text": "4本目。VRシューターのForefrontに、大型アップデートなのだ。",
   "face": "normal",
   "section": 4,
   "start": 102.425,
   "end": 107.406
  },
  {
   "who": "zundamon",
   "text": "拠点を奪い合う、新しいモードが加わったのだ。",
   "face": "normal",
   "section": 4,
   "start": 107.656,
   "end": 111.101
  },
  {
   "who": "zundamon",
   "text": "初めての近接武器、ナイフも登場なのだ。",
   "face": "normal",
   "section": 4,
   "start": 111.351,
   "end": 114.765
  },
  {
   "who": "kiritan",
   "text": "銃のゲームでナイフ。上級者向けの気配がします。",
   "face": "look",
   "section": 4,
   "start": 115.015,
   "end": 118.236
  },
  {
   "who": "zundamon",
   "text": "チャレンジで報酬がもらえる仕組みも始まったのだ。",
   "face": "normal",
   "section": 4,
   "start": 118.486,
   "end": 121.665
  },
  {
   "who": "kiritan",
   "text": "無料分と有料分があるやつですね。",
   "face": "nihilistic",
   "section": 4,
   "start": 121.915,
   "end": 124.155
  },
  {
   "who": "zundamon",
   "text": "PS VR2版は11月5日に出る予定なのだ。",
   "face": "normal",
   "section": 4,
   "start": 124.405,
   "end": 128.81
  },
  {
   "who": "zundamon",
   "text": "最後は星座占いなのだ。イタコ、よろしくなのだ！",
   "face": "smile",
   "section": 5,
   "start": 129.61,
   "end": 133.482
  },
  {
   "who": "itako",
   "text": "今日の1位はしし座。思い切った挑戦が実を結びますわ。",
   "face": "smile",
   "section": 5,
   "start": 133.732,
   "end": 138.223
  },
  {
   "who": "itako",
   "text": "2位はうお座、3位はふたご座です。",
   "face": "normal",
   "section": 5,
   "start": 138.473,
   "end": 141.961
  },
  {
   "who": "zundamon",
   "text": "ふたご座は、買い物で良い発見があるのだ。メタフェス日和なのだ。",
   "face": "normal",
   "section": 5,
   "start": 142.211,
   "end": 146.829
  },
  {
   "who": "itako",
   "text": "そして12位はさそり座。焦らず一歩ずつで大丈夫ですわ。",
   "face": "normal",
   "section": 5,
   "start": 147.079,
   "end": 152.349
  },
  {
   "who": "zundamon",
   "text": "ラッキーアイテムはずんだ餅。それなら僕に任せるのだ！",
   "face": "smile",
   "section": 5,
   "start": 152.599,
   "end": 156.876
  },
  {
   "who": "zundamon",
   "text": "今日も聞いてくれてありがとうなのだ！",
   "face": "smile",
   "section": 6,
   "start": 157.676,
   "end": 159.873
  },
  {
   "who": "kiritan",
   "text": "わたしはメタフェスの会場を、こっそり回ってきます。",
   "face": "smile",
   "section": 6,
   "start": 160.123,
   "end": 163.249
  },
  {
   "who": "zundamon",
   "text": "また明日なのだ！",
   "face": "smile",
   "section": 6,
   "start": 163.499,
   "end": 164.683
  }
 ],
